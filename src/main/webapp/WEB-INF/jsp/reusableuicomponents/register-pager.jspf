<div data-table-pagination data-page="${records.page()}" data-table-for="${resourceKey}"><c:if test="${records.page() > 0}"><c:url var="previousUrl" value="${baseUrl}"><c:if test="${not empty year}"><c:param name="year" value="${year}"/></c:if><c:if test="${not empty parentId}"><c:param name="parentId" value="${parentId}"/></c:if><c:if test="${not empty journalKind}"><c:param name="kind" value="${journalKind}"/></c:if><c:if test="${not empty activityId}"><c:param name="activityId" value="${activityId}"/></c:if><c:if test="${not empty selectedReview}"><c:param name="review" value="${selectedReview}"/></c:if><c:param name="page" value="${records.page()-1}" /><c:param name="ownerId" value="${query.ownerId}"/><c:param name="clientId" value="${query.clientId}"/><c:param name="search" value="${query.search}" /><c:param name="sort" value="${query.sort}" /><c:param name="direction" value="${query.direction}" /><c:param name="size" value="${query.size}" /><c:param name="status" value="${query.status}" /><c:param name="from" value="${query.from}" /><c:param name="to" value="${query.to}" /></c:url><a data-page-direction="previous" href="<c:out value='${previousUrl}' />"><spring:message code="common.previous"/></a></c:if><c:if test="${records.hasNext()}"><c:url var="nextUrl" value="${baseUrl}"><c:if test="${not empty year}"><c:param name="year" value="${year}"/></c:if><c:if test="${not empty parentId}"><c:param name="parentId" value="${parentId}"/></c:if><c:if test="${not empty journalKind}"><c:param name="kind" value="${journalKind}"/></c:if><c:if test="${not empty activityId}"><c:param name="activityId" value="${activityId}"/></c:if><c:if test="${not empty selectedReview}"><c:param name="review" value="${selectedReview}"/></c:if><c:param name="page" value="${records.page()+1}" /><c:param name="ownerId" value="${query.ownerId}"/><c:param name="clientId" value="${query.clientId}"/><c:param name="search" value="${query.search}" /><c:param name="sort" value="${query.sort}" /><c:param name="direction" value="${query.direction}" /><c:param name="size" value="${query.size}" /><c:param name="status" value="${query.status}" /><c:param name="from" value="${query.from}" /><c:param name="to" value="${query.to}" /></c:url><a data-page-direction="next" href="<c:out value='${nextUrl}' />"><spring:message code="common.next"/></a></c:if></div>