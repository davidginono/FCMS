<%@ page pageEncoding="UTF-8" %><aside id="fcms-sidebar" data-fcms-sidebar-panel class="app-sidebar" aria-label="<spring:message code='nav.primary'/>"><div class="app-sidebar-toggle-row"><h2 class="app-sidebar-toggle-label"><a class="app-sidebar-home" href="<c:url value='/dashboard'/>">FCMS</a></h2><button type="button" class="app-sidebar-close" data-shell-sidebar-close aria-controls="fcms-sidebar" aria-expanded="true" aria-label="<spring:message code='nav.close'/>"><svg class="app-sidebar-collapse-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m12 4-6 6 6 6"/></svg><svg class="app-sidebar-expand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button></div><nav id="fcms-sidebar-nav" class="app-sidebar-nav" data-fcms-persist-scroll data-fcms-scroll-key="primary-sidebar-nav">
<c:choose><c:when test="${staffWorkspace}"><%@ include file="staff-navigation.jspf" %></c:when><c:otherwise>
<div class="app-sidebar-section"><c:if test="${permissions.contains('dashboard.read')}"><a class="app-sidebar-link" href="<c:url value='/dashboard'/>"><span class="app-sidebar-label"><spring:message code="nav.dashboard"/></span></a></c:if>
</div>
<c:if test="${accountingWorkspace or directorWorkspace}">
<c:if test="${permissions.contains('client.read')}"><details class="app-sidebar-section-group" data-nav-group="clients" open><summary class="app-sidebar-group-title"><ui:navigationCaret/><span><spring:message code="nav.clients"/></span></summary><c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/saccos'/>"><span class="app-sidebar-label"><spring:message code="client.category.saccos"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/amcos'/>"><span class="app-sidebar-label"><spring:message code="client.category.amcos"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/unions'/>"><span class="app-sidebar-label"><spring:message code="client.category.unions"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/microfinance'/>"><span class="app-sidebar-label"><spring:message code="client.category.microfinance_clients"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/others'/>"><span class="app-sidebar-label"><spring:message code="client.category.other_clients"/></span></a></c:if>
</details></c:if>
<c:if test="${permissions.contains('sales.prospect.read') or permissions.contains('sales.invoice.read')}"><details class="app-sidebar-section-group" data-nav-group="sales" open><summary class="app-sidebar-group-title"><ui:navigationCaret/><span><spring:message code="nav.sales"/></span></summary><c:if test="${permissions.contains('sales.prospect.read')}"><a class="app-sidebar-link" href="<c:url value='/sales/prospects'/>"><span class="app-sidebar-label"><spring:message code="sales.prospect.title"/></span></a></c:if><c:if test="${permissions.contains('sales.invoice.read')}"><a class="app-sidebar-link" href="<c:url value='/sales/invoices'/>"><span class="app-sidebar-label"><spring:message code="sales.invoice.title"/></span></a></c:if></details></c:if>
</c:if>
<%@ include file="finance-navigation.jspf" %>
<c:if test="${directorWorkspace}">
<c:if test="${permissions.contains('task.read') or permissions.contains('leave.read') or permissions.contains('staff-report.read')}"><details class="app-sidebar-section-group" data-nav-group="operations" open><summary class="app-sidebar-group-title"><ui:navigationCaret/><span><spring:message code="nav.operations"/></span></summary><c:if test="${permissions.contains('task.read')}"><a class="app-sidebar-link" href="<c:url value='/tasks'/>"><span class="app-sidebar-label"><spring:message code="nav.tasks"/></span></a></c:if>
<c:if test="${permissions.contains('leave.read')}"><a class="app-sidebar-link" href="<c:url value='/leaves'/>"><span class="app-sidebar-label"><spring:message code="nav.leaves"/></span></a></c:if>
<c:if test="${permissions.contains('staff-report.read')}"><a class="app-sidebar-link" href="<c:url value='/staff-reports'/>"><span class="app-sidebar-label"><spring:message code="nav.staffReports"/></span></a></c:if>
</details></c:if>
</c:if>
<c:if test="${administrationWorkspace}">
<c:if test="${permissions.contains('iam.user.read') or permissions.contains('account.write') or permissions.contains('backup.manage')}"><details class="app-sidebar-section-group" data-nav-group="administration" open><summary class="app-sidebar-group-title"><ui:navigationCaret/><span><spring:message code="nav.administration"/></span></summary><c:if test="${permissions.contains('iam.user.read')}"><a class="app-sidebar-link" href="<c:url value='/admin/users'/>"><span class="app-sidebar-label"><spring:message code="nav.users"/></span></a></c:if>
<c:if test="${permissions.contains('account.write')}"><a class="app-sidebar-link" href="<c:url value='/account'/>"><span class="app-sidebar-label"><spring:message code="nav.account"/></span></a></c:if>
<c:if test="${permissions.contains('backup.manage')}"><a class="app-sidebar-link" href="<c:url value='/backups'/>"><span class="app-sidebar-label"><spring:message code="nav.backups"/></span></a></c:if>
</details></c:if>
</c:if>
</c:otherwise></c:choose></nav></aside>
