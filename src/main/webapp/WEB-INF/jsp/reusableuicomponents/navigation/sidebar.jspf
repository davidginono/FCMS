<%@ page pageEncoding="UTF-8" %><aside id="fcms-sidebar" data-fcms-sidebar-panel class="app-sidebar" aria-label="Primary navigation"><nav class="app-sidebar-nav" data-fcms-persist-scroll data-fcms-scroll-key="primary-sidebar-nav">
<div class="app-sidebar-section"><c:if test="${permissions.contains('dashboard.read')}"><a class="app-sidebar-link" href="<c:url value='/dashboard'/>"><span class="app-sidebar-label"><spring:message code="nav.dashboard"/></span></a></c:if>
</div>
<c:if test="${permissions.contains('client.read')}"><div class="app-sidebar-section"><div class="app-sidebar-heading"><spring:message code="nav.clients"/></div><c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/saccos'/>"><span class="app-sidebar-label"><spring:message code="client.category.saccos"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/amcos'/>"><span class="app-sidebar-label"><spring:message code="client.category.amcos"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/unions'/>"><span class="app-sidebar-label"><spring:message code="client.category.unions"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/microfinance'/>"><span class="app-sidebar-label"><spring:message code="client.category.microfinance_clients"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/others'/>"><span class="app-sidebar-label"><spring:message code="client.category.other_clients"/></span></a></c:if>
</div></c:if>
<c:if test="${permissions.contains('sales.prospect.read') or permissions.contains('sales.invoice.read')}"><div class="app-sidebar-section"><div class="app-sidebar-heading"><spring:message code="nav.sales"/></div><c:if test="${permissions.contains('sales.prospect.read')}"><a class="app-sidebar-link" href="<c:url value='/sales/prospects'/>"><span class="app-sidebar-label"><spring:message code="sales.prospect.title"/></span></a></c:if><c:if test="${permissions.contains('sales.invoice.read')}"><a class="app-sidebar-link" href="<c:url value='/sales/invoices'/>"><span class="app-sidebar-label"><spring:message code="sales.invoice.title"/></span></a></c:if></div></c:if>
<c:if test="${permissions.contains('task.read') or permissions.contains('leave.read') or permissions.contains('staff-report.read')}"><div class="app-sidebar-section"><div class="app-sidebar-heading"><spring:message code="nav.operations"/></div><c:if test="${permissions.contains('task.read')}"><a class="app-sidebar-link" href="<c:url value='/tasks'/>"><span class="app-sidebar-label"><spring:message code="nav.tasks"/></span></a></c:if>
<c:if test="${permissions.contains('leave.read')}"><a class="app-sidebar-link" href="<c:url value='/leaves'/>"><span class="app-sidebar-label"><spring:message code="nav.leaves"/></span></a></c:if>
<c:if test="${permissions.contains('staff-report.read')}"><a class="app-sidebar-link" href="<c:url value='/staff-reports'/>"><span class="app-sidebar-label"><spring:message code="nav.staffReports"/></span></a></c:if>
</div></c:if>
<%@ include file="finance-navigation.jspf" %>
<c:if test="${permissions.contains('iam.user.read') or permissions.contains('account.write') or permissions.contains('backup.manage')}"><div class="app-sidebar-section"><div class="app-sidebar-heading"><spring:message code="nav.administration"/></div><c:if test="${permissions.contains('iam.user.read')}"><a class="app-sidebar-link" href="<c:url value='/admin/users'/>"><span class="app-sidebar-label"><spring:message code="nav.users"/></span></a></c:if>
<c:if test="${permissions.contains('account.write')}"><a class="app-sidebar-link" href="<c:url value='/account'/>"><span class="app-sidebar-label"><spring:message code="nav.account"/></span></a></c:if>
<c:if test="${permissions.contains('backup.manage')}"><a class="app-sidebar-link" href="<c:url value='/backups'/>"><span class="app-sidebar-label"><spring:message code="nav.backups"/></span></a></c:if>
</div></c:if>
<c:if test="${permissions.contains('client.read')}"><div class="app-sidebar-section"><div class="app-sidebar-heading"><spring:message code="report.clients"/></div><c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/saccos?view=revenue'/>"><span class="app-sidebar-label"><spring:message code="client.category.saccos"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/amcos?view=revenue'/>"><span class="app-sidebar-label"><spring:message code="client.category.amcos"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/unions?view=revenue'/>"><span class="app-sidebar-label"><spring:message code="client.category.unions"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/microfinance?view=revenue'/>"><span class="app-sidebar-label"><spring:message code="client.category.microfinance_clients"/></span></a></c:if>
<c:if test="${permissions.contains('client.read')}"><a class="app-sidebar-link" href="<c:url value='/clients/others?view=revenue'/>"><span class="app-sidebar-label"><spring:message code="client.category.other_clients"/></span></a></c:if>
</div></c:if></nav></aside>