<%@ page pageEncoding="UTF-8" %>
<c:if test="${accountingWorkspace and (permissions.contains('finance.read') or permissions.contains('finance.gl-source.read') or permissions.contains('accounting.read'))}">
<details class="app-sidebar-section-group" data-nav-group="accounting-office" open>
<summary class="app-sidebar-group-title"><ui:navigationCaret/><span><spring:message code="gl.office"/></span></summary>
<c:if test="${permissions.contains('finance.read') or permissions.contains('finance.gl-source.read')}">
<details class="app-sidebar-section" data-nav-group="financial-transactions" open>
<summary class="app-sidebar-heading"><ui:navigationCaret/><span><spring:message code="config.transactions"/></span></summary>
<c:if test="${permissions.contains('finance.read')}">
<a class="app-sidebar-link" href="<c:url value='/finance/petty-cash'/>"><span class="app-sidebar-label"><spring:message code="nav.petty"/></span></a>
<a class="app-sidebar-link" href="<c:url value='/finance/cloud-backup'/>"><span class="app-sidebar-label"><spring:message code="nav.cloud"/></span></a>
<a class="app-sidebar-link" href="<c:url value='/finance/bulk-sms'/>"><span class="app-sidebar-label"><spring:message code="nav.bulk"/></span></a>
</c:if>
<c:if test="${permissions.contains('finance.gl-source.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/sources'/>"><span class="app-sidebar-label"><spring:message code="gl.sources"/></span></a></c:if>
</details>
</c:if>
<c:if test="${permissions.contains('accounting.read')}">

<details class="app-sidebar-section" data-nav-group="vouchers" open>
<summary class="app-sidebar-heading"><ui:navigationCaret/><span><spring:message code="gl.vouchers"/></span></summary>
<a class="app-sidebar-link" href="<c:url value='/accounting/vouchers/receipts'/>"><span class="app-sidebar-label"><spring:message code="gl.receipts"/></span></a>
<a class="app-sidebar-link" href="<c:url value='/accounting/vouchers/payments'/>"><span class="app-sidebar-label"><spring:message code="gl.payments"/></span></a>
<a class="app-sidebar-link" href="<c:url value='/accounting/vouchers/journals'/>"><span class="app-sidebar-label"><spring:message code="gl.journals"/></span></a>
</details>
<details class="app-sidebar-section" data-nav-group="accounting-configuration" open>
<summary class="app-sidebar-heading"><ui:navigationCaret/><span><spring:message code="workspace.configuration"/></span></summary>
<a class="app-sidebar-link" href="<c:url value='/accounting/accounts'/>"><span class="app-sidebar-label"><spring:message code="gl.accounts"/></span></a>
<a class="app-sidebar-link" href="<c:url value='/accounting/config/activities'/>"><span class="app-sidebar-label"><spring:message code="config.activities"/></span></a>
<a class="app-sidebar-link" href="<c:url value='/accounting/config/transactions'/>"><span class="app-sidebar-label"><spring:message code="config.transactions"/></span></a>
</details>
</c:if>
</details>
</c:if>
<c:if test="${(accountingWorkspace or directorWorkspace) and permissions.contains('accounting.report')}">
<details class="app-sidebar-section-group" data-nav-group="financial-reports" open>
<summary class="app-sidebar-group-title"><ui:navigationCaret/><span><spring:message code="nav.reports"/></span></summary>
<a class="app-sidebar-link" href="<c:url value='/accounting/statements'/>"><span class="app-sidebar-label"><spring:message code="gl.statements"/></span></a>
</details>
</c:if>
