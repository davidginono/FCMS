<%@ page pageEncoding="UTF-8" %>
<c:if test="${permissions.contains('finance.read') or permissions.contains('expense.read') or permissions.contains('report.read') or permissions.contains('accounting.read')}"><div class="app-sidebar-section"><div class="app-sidebar-heading"><spring:message code="gl.office"/></div>
<c:if test="${permissions.contains('accounting.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/accounts'/>"><span class="app-sidebar-label"><spring:message code="gl.accounts"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/books'/>"><span class="app-sidebar-label"><spring:message code="gl.books"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/periods'/>"><span class="app-sidebar-label"><spring:message code="gl.periods"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.read')}"><div class="config-navigation-group"><div class="app-sidebar-heading"><spring:message code="config.title"/></div><a class="app-sidebar-link" href="<c:url value='/accounting/config/activities'/>"><span class="app-sidebar-label"><spring:message code="config.activities"/></span></a><a class="app-sidebar-link" href="<c:url value='/accounting/config/transactions'/>"><span class="app-sidebar-label"><spring:message code="config.transactions"/></span></a></div></c:if>
<c:if test="${permissions.contains('accounting.read') and permissions.contains('finance.gl-source.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/sources'/>"><span class="app-sidebar-label"><spring:message code="gl.sources"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/journals'/>"><span class="app-sidebar-label"><spring:message code="gl.journals"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/journals?kind=RECEIPT'/>"><span class="app-sidebar-label"><spring:message code="gl.receipts"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.read')}"><a class="app-sidebar-link" href="<c:url value='/accounting/journals?kind=PAYMENT'/>"><span class="app-sidebar-label"><spring:message code="gl.payments"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.report')}"><a class="app-sidebar-link" href="<c:url value='/accounting/trial-balance'/>"><span class="app-sidebar-label"><spring:message code="gl.trialBalance"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.report')}"><a class="app-sidebar-link" href="<c:url value='/accounting/statements/income-statement'/>"><span class="app-sidebar-label"><spring:message code="gl.statement.income-statement"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.report')}"><a class="app-sidebar-link" href="<c:url value='/accounting/statements/balance-sheet'/>"><span class="app-sidebar-label"><spring:message code="gl.statement.balance-sheet"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.report')}"><a class="app-sidebar-link" href="<c:url value='/accounting/statements/cash-flow'/>"><span class="app-sidebar-label"><spring:message code="gl.statement.cash-flow"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.report')}"><a class="app-sidebar-link" href="<c:url value='/accounting/statements/changes-in-equity'/>"><span class="app-sidebar-label"><spring:message code="gl.statement.changes-in-equity"/></span></a></c:if>
<c:if test="${permissions.contains('accounting.report')}"><a class="app-sidebar-link" href="<c:url value='/accounting/statements/notes'/>"><span class="app-sidebar-label"><spring:message code="gl.statement.notes"/></span></a></c:if>
<c:if test="${permissions.contains('expense.read')}"><a class="app-sidebar-link" href="<c:url value='/finance/expenses'/>"><span class="app-sidebar-label"><spring:message code="nav.expenses"/></span></a></c:if>
<c:if test="${permissions.contains('finance.read')}"><a class="app-sidebar-link" href="<c:url value='/finance/income'/>"><span class="app-sidebar-label"><spring:message code="nav.income"/></span></a></c:if>
<c:if test="${permissions.contains('finance.read')}"><a class="app-sidebar-link" href="<c:url value='/finance/petty-cash'/>"><span class="app-sidebar-label"><spring:message code="nav.petty"/></span></a></c:if>
<c:if test="${permissions.contains('finance.read')}"><a class="app-sidebar-link" href="<c:url value='/finance/cloud-backup'/>"><span class="app-sidebar-label"><spring:message code="nav.cloud"/></span></a></c:if>
<c:if test="${permissions.contains('finance.read')}"><a class="app-sidebar-link" href="<c:url value='/finance/bulk-sms'/>"><span class="app-sidebar-label"><spring:message code="nav.bulk"/></span></a></c:if>
<c:if test="${permissions.contains('finance.read')}"><a class="app-sidebar-link" href="<c:url value='/finance/cloud-backup/billing'/>"><span class="app-sidebar-label"><spring:message code="cloud.billing"/></span></a></c:if>
<c:if test="${permissions.contains('report.read')}"><a class="app-sidebar-link" href="<c:url value='/reports'/>"><span class="app-sidebar-label"><spring:message code="gl.operationalSummary"/></span></a></c:if>
<c:if test="${permissions.contains('expense.read') and (permissions.contains('expense.evidence.write') or permissions.contains('expense.evidence.review'))}"><a class="app-sidebar-link" href="<c:url value='/finance/expenses/evidence'/>"><span class="app-sidebar-label"><spring:message code="expense.evidence.title"/></span></a></c:if>
</div></c:if>

