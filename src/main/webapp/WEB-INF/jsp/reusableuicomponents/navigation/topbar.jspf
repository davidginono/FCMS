<header class="app-topbar">
    <div class="app-topbar-inner">
        <div class="app-topbar-left">
            <button data-fcms-sidebar-toggle type="button" class="app-icon-button" aria-controls="fcms-sidebar" aria-expanded="false" aria-label="Open navigation">
                <span class="app-icon" data-lucide="menu" aria-hidden="true"></span>
            </button>
            <a class="app-global-brand" href="<c:url value='/dashboard' />" aria-label="FCMS console home">FCMS</a>
        </div>
        <div class="app-topbar-actions">
            <c:forTokens items="en,sw" delims="," var="language"><c:url var="languageUrl" value=""><c:forTokens items="from,to,page,size,status,sort,direction,search,financialYearId,paymentStatusId,parentId,kind,view,reportType,ownerId,clientId,activityId,review,group,groupPage,ledgerAccount" delims="," var="filterKey"><c:if test="${not empty param[filterKey]}"><c:param name="${filterKey}" value="${param[filterKey]}"/></c:if></c:forTokens><c:param name="lang" value="${language}"/></c:url><a class="app-topbar-logout" href="<c:out value='${languageUrl}'/>">${language=='en'?'English':'Kiswahili'}</a></c:forTokens>
            <a class="app-user-chip" href="<c:url value='/account'/>">
                <span class="app-icon" data-lucide="user-circle" aria-hidden="true"></span>
                <span class="app-user-name"><c:out value="${pageContext.request.userPrincipal.name}" /></span>
            </a>
            <form method="post" action="<c:url value='/logout' />">
                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                <button type="submit" class="app-topbar-logout">
                    <span class="app-icon" data-lucide="log-out" aria-hidden="true"></span>
                    <spring:message code="nav.logout" />
                </button>
            </form>
        </div>
    </div>
</header>
