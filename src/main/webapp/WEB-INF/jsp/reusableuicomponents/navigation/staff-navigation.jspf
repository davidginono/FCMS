<%@ page pageEncoding="UTF-8" %>
<div class="app-sidebar-section" data-staff-workspace>
<c:if test="${permissions.contains('dashboard.read')}"><a class="app-sidebar-link" href="<c:url value='/staff/dashboard'/>"><span class="app-sidebar-label"><spring:message code="workspace.my.dashboard"/></span></a></c:if>
<c:if test="${permissions.contains('staff-report.read')}"><a class="app-sidebar-link" href="<c:url value='/staff-reports'/>"><span class="app-sidebar-label"><spring:message code="workspace.my.staff-report"/></span></a></c:if>
<c:if test="${permissions.contains('leave.read')}"><a class="app-sidebar-link" href="<c:url value='/leaves'/>"><span class="app-sidebar-label"><spring:message code="workspace.my.leave"/></span></a></c:if>
</div>
