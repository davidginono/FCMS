<form method="get" action="<c:url value='${baseUrl}' />"><c:if test="${not empty journalKind}"><input type="hidden" name="kind" value="<c:out value='${journalKind}'/>"></c:if><c:if test="${not empty parentId and empty filterGlParents}"><input type="hidden" name="parentId" value="${parentId}"></c:if><c:if test="${not empty filterGlParents}"><label><spring:message code="gl.parent"/><select name="parentId" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=false"><option value=""><spring:message code="common.all"/></option><c:forEach items="${filterGlParents}" var="option"><option value="${option.id()}" ${parentId==option.id()?'selected':''}><c:out value="${option.name()}"/></option></c:forEach></select></label></c:if><c:if test="${not empty filterActivities}"><label><spring:message code="config.activity"/><select name="activityId" data-choice-url="${pageContext.request.contextPath}/accounting/config/activities/choices"><option value=""><spring:message code="common.all"/></option><c:forEach items="${filterActivities}" var="option"><option value="${option.id()}" ${activityId==option.id()?'selected':''}><c:out value="${option.name()}"/></option></c:forEach></select></label></c:if><input type="hidden" name="sort" value="<c:out value='${query.sort}' />"><input type="hidden" name="direction" value="<c:out value='${query.direction}' />"><input type="hidden" name="size" value="${query.size}"><label><spring:message code="common.search" /><input type="search" name="search" value="<c:out value='${query.search}' />" maxlength="100"></label><c:if test="${resourceKey!='users' and not hideDateFilters}"><label><spring:message code="common.from" /><input type="date" name="from" value="<c:out value='${query.from}' />"></label><label><spring:message code="common.to" /><input type="date" name="to" value="<c:out value='${query.to}' />"></label></c:if><c:if test="${not empty registerStatuses}"><label><spring:message code="common.status"/><select name="status"><option value=""><spring:message code="common.all"/></option><c:forEach items="${registerStatuses}" var="status"><option value="${status}" ${query.status==status?'selected':''}><spring:message code="status.${status}"/></option></c:forEach></select></label></c:if><c:if test="${not empty filterStaff}"><label><spring:message code="common.staff"/><select name="ownerId" data-choice-url="${pageContext.request.contextPath}/lookups/staff"><option value=""><spring:message code="common.all"/></option><c:forEach items="${filterStaff}" var="option"><option value="${option.id()}" ${query.ownerId==option.id()?'selected':''}><c:out value="${option.name()}"/></option></c:forEach></select></label></c:if><c:if test="${not empty filterClients}"><label><spring:message code="common.client"/><select name="clientId" data-choice-url="${pageContext.request.contextPath}/lookups/clients"><option value=""><spring:message code="common.all"/></option><c:forEach items="${filterClients}" var="option"><option value="${option.id()}" ${query.clientId==option.id()?'selected':''}><c:out value="${option.name()}"/></option></c:forEach></select></label></c:if><button class="app-btn btn-neutral" type="submit"><spring:message code="common.apply" /></button><a class="app-btn btn-neutral" href="<c:url value='${baseUrl}' />"><spring:message code="common.clear" /></a></form>