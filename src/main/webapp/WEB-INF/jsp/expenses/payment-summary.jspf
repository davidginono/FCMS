<%@ page pageEncoding="UTF-8" %>
<section class="erp-resource-section"><h2><spring:message code="common.details"/></h2><div class="fcms-section-body"><dl class="fcms-details">
<div><dt><spring:message code="nav.expenses"/></dt><dd>#<c:out value="${payment.id()}"/></dd></div>
<div><dt><spring:message code="expense.evidence.expenseDate"/></dt><dd><c:out value="${appTime:date(payment.expenseDate())}"/></dd></div>
<div><dt><spring:message code="common.staff"/></dt><dd><c:out value="${payment.owner()}"/></dd></div>
<div><dt><spring:message code="expense.payee"/></dt><dd><c:out value="${payment.payee()}"/></dd></div>
<div><dt><spring:message code="common.description"/></dt><dd><c:out value="${payment.description()}"/></dd></div>
<div><dt><spring:message code="common.amount"/></dt><dd><fmt:formatNumber value="${payment.amount()}" minFractionDigits="2" maxFractionDigits="2"/></dd></div>
<div><dt><spring:message code="expense.paymentReference"/></dt><dd><c:out value="${payment.paymentReference()}"/></dd></div>
<div><dt><spring:message code="common.status"/></dt><dd><spring:message code="status.${payment.expenseStatus()}"/></dd></div>
<div><dt><spring:message code="expense.evidence.status"/></dt><dd><spring:message code="status.${payment.evidenceState()}"/></dd></div>
</dl></div></section>
