<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="expense.evidence.title"/></h1><c:if test="${workspace.canCreate()}"><a class="app-btn btn-launch" href="<c:url value='/finance/expenses/${payment.id()}/evidence/new'/>"><spring:message code="expense.evidence.prepare"/></a></c:if></div>
<c:if test="${not empty actionError}"><div class="fcms-alert" role="alert"><spring:message code="${actionError}"/></div></c:if>
<%@ include file="/WEB-INF/jsp/expenses/payment-summary.jspf" %>
<c:if test="${not empty evidence}"><section class="erp-resource-section"><h2><spring:message code="expense.evidence.record"/> #<c:out value="${evidence.id()}"/></h2><div class="fcms-section-body"><dl class="fcms-details">
<div><dt><spring:message code="common.status"/></dt><dd><spring:message code="status.${evidence.state()}"/></dd></div><div><dt><spring:message code="client.datePaid"/></dt><dd><c:out value="${appTime:date(evidence.paidOn())}"/></dd></div>
<div><dt><spring:message code="expense.evidence.payer"/></dt><dd><c:out value="${evidence.payer()}"/> #<c:out value="${evidence.payerId()}"/></dd></div><div><dt><spring:message code="expense.paymentReference"/></dt><dd><c:out value="${evidence.paymentReference()}"/></dd></div>
<div><dt><spring:message code="expense.evidence.document"/></dt><dd><c:out value="${evidence.documentReference()}"/></dd></div><div><dt><spring:message code="common.reason"/></dt><dd><c:out value="${evidence.explanation()}"/></dd></div>
<div><dt><spring:message code="expense.evidence.openingPolicy"/></dt><dd><c:out value="${evidence.openingPolicyReference()}"/></dd></div><div><dt><spring:message code="gl.maker"/></dt><dd><c:out value="${evidence.maker()}"/> #<c:out value="${evidence.makerId()}"/></dd></div><div><dt><spring:message code="ledger.recordedAt"/></dt><dd><c:out value="${appTime:display(evidence.createdAt())}"/></dd></div>
<div><dt><spring:message code="gl.checker"/></dt><dd><c:out value="${evidence.checker()}"/> <c:if test="${not empty evidence.checkerId()}">#<c:out value="${evidence.checkerId()}"/></c:if></dd></div><div><dt><spring:message code="gl.reviewComment"/></dt><dd><c:out value="${evidence.reviewComment()}"/></dd></div><div><dt><spring:message code="expense.evidence.reviewedAt"/></dt><dd><c:out value="${appTime:display(evidence.reviewedAt())}"/></dd></div>
</dl></div></section>
<c:if test="${workspace.canReview() or workspace.canCancel()}"><form class="fcms-form" method="post" action="<c:url value='/finance/expenses/${payment.id()}/evidence/${evidence.id()}/review'/>" data-resource-form-page data-financial-form><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${evidence.version()}"><section class="erp-resource-section"><h2><spring:message code="gl.review"/></h2><div class="fcms-section-body"><div class="fcms-field"><label for="review-comment"><spring:message code="common.reason"/></label><textarea id="review-comment" name="comment" maxlength="1000" required><c:out value="${attemptedComment}"/></textarea></div><div class="app-actions"><c:if test="${workspace.canReview()}"><button class="app-btn btn-launch" name="action" value="approve" type="submit"><spring:message code="common.approve"/></button><button class="app-btn btn-neutral" name="action" value="reject" type="submit"><spring:message code="common.reject"/></button></c:if><c:if test="${workspace.canCancel()}"><button class="app-btn btn-neutral" name="action" value="cancel" type="submit"><spring:message code="common.cancel"/></button></c:if></div></div></section></form></c:if>
<c:if test="${not empty actionError and not empty attemptedComment and not workspace.canReview() and not workspace.canCancel()}"><section class="erp-resource-section"><h2><spring:message code="expense.evidence.attemptedReview"/></h2><div class="fcms-section-body"><c:out value="${attemptedComment}"/></div></section></c:if></c:if>
<section class="erp-table-wrap" data-resource-table="${resourceKey}" data-table-page-size="${query.size}" data-table-page-size-options="10 25 50 100"><div class="app-table-titlebar"><h2><spring:message code="expense.history"/></h2></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-filters.jspf" %>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-sort-key="id" data-table-sort-asc="id" data-table-sort-desc="id">ID</th><th data-table-sort-key="date" data-table-sort-asc="date" data-table-sort-desc="date"><spring:message code="ledger.recordedAt"/></th><th data-table-sort-key="paidOn" data-table-sort-asc="paidOn" data-table-sort-desc="paidOn"><spring:message code="client.datePaid"/></th><th data-table-sort-key="maker" data-table-sort-asc="maker" data-table-sort-desc="maker"><spring:message code="gl.maker"/></th><th data-table-sort-key="evidence" data-table-sort-asc="evidence" data-table-sort-desc="evidence"><spring:message code="expense.evidence.document"/></th><th data-table-sort-key="status" data-table-sort-asc="status" data-table-sort-desc="status"><spring:message code="common.status"/></th></tr></thead><tbody>
<c:forEach items="${records.rows()}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='/finance/expenses/${payment.id()}/evidence/${row.id()}'/>">#<c:out value="${row.id()}"/></a></td><td><c:out value="${appTime:display(row.createdAt())}"/></td><td><c:out value="${appTime:date(row.paidOn())}"/></td><td><c:out value="${row.maker()}"/></td><td><c:out value="${row.documentReference()}"/></td><td><spring:message code="status.${row.state()}"/></td></tr></c:forEach><c:if test="${empty records.rows()}"><tr><td colspan="6"><spring:message code="common.noRecords"/></td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %></section>
<%@ include file="/WEB-INF/jsp/reusableuicomponents/form-support.jspf" %><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
