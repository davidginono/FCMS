<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="client.archive"/> · <spring:message code="${clientLabel}"/></h1><a class="app-btn btn-neutral" href="<c:url value='${clientRoute}'/>"><spring:message code="common.back"/></a></div>
<section class="erp-table-wrap" data-resource-table="${resourceKey}" data-table-selection="single" data-table-page-size="${query.size}" data-table-page-size-options="10 25 50 100"><div class="app-table-titlebar"><h2><spring:message code="client.archivedRecords"/></h2></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-filters.jspf" %>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-sort-key="id" data-table-sort-asc="id" data-table-sort-desc="id">ID</th><th data-table-sort-key="name" data-table-sort-asc="name" data-table-sort-desc="name"><spring:message code="common.name"/></th><th data-table-sort-key="region" data-table-sort-asc="region" data-table-sort-desc="region"><spring:message code="client.region"/></th><th data-table-sort-key="year" data-table-sort-asc="year" data-table-sort-desc="year"><spring:message code="common.year"/></th><th data-table-sort-key="amount" data-table-sort-asc="amount" data-table-sort-desc="amount"><spring:message code="client.amountPaid"/></th><th data-table-sort-key="date" data-table-sort-asc="date" data-table-sort-desc="date"><spring:message code="client.updatedAt"/></th><th data-table-actions-header><spring:message code="common.actions"/></th></tr></thead><tbody><c:forEach items="${records.rows()}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='${baseUrl}/${row.id()}'/>"><c:out value="${row.id()}"/></a></td><td><c:out value="${row.name()}"/></td><td><c:out value="${row.region()}"/></td><td><c:out value="${row.year()}"/></td><td><fmt:formatNumber value="${row.amount()}" minFractionDigits="2" maxFractionDigits="2"/></td><td><c:out value="${appTime:display(row.updatedAt())}"/></td><td><a class="app-btn btn-neutral" href="<c:url value='${baseUrl}/${row.id()}'/>"><spring:message code="common.details"/></a></td></tr></c:forEach><c:if test="${empty records.rows()}"><tr><td colspan="7"><spring:message code="common.noRecords"/></td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %></section>
<%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
