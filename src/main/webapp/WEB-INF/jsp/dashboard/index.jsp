<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="${staffWorkspace?'workspace.my.dashboard':accountingWorkspace?'workspace.accountantDashboard':'workspace.directorDashboard'}"/></h1></div>
<c:if test="${not staffWorkspace}"><form method="get" class="dashboard-year-form">
<label><spring:message code="common.year"/><select name="financialYearId"><c:forEach items="${overview.years()}" var="year"><option value="${year.id()}" ${year.id()==overview.selected().id()?'selected':''}>${year.label()}</option></c:forEach></select></label>
<label><spring:message code="ledger.category"/><select name="category"><c:forTokens items="saccos,amcos,unions,microfinance,others" delims="," var="category"><option value="${category}" ${dashboardCategory==category?'selected':''}><spring:message code="client.dashboard.${category}"/></option></c:forTokens></select></label>
<button class="app-btn btn-neutral"><spring:message code="common.apply"/></button></form></c:if>
<div class="dashboard-grid dashboard-grid--business">
<c:forEach items="${overview.work()}" var="metric"><section class="dashboard-widget" data-dashboard-work="${metric.label()}"><h2><spring:message code="${metric.label()}"/></h2><div class="dashboard-widget-body"><a class="dashboard-value" href="<c:url value='${metric.href()}'/>">${metric.value()}</a></div></section></c:forEach>
<c:forEach items="${overview.portfolios()}" var="portfolio"><c:url var="clientUrl" value="/clients/${portfolio.slug()}"><c:if test="${portfolio.slug()!='others'}"><c:param name="financialYearId" value="${overview.selected().id()}"/></c:if></c:url>
<section class="dashboard-widget" data-dashboard-client="${portfolio.slug()}"><h2><spring:message code="client.category.${portfolio.category()}"/><c:if test="${portfolio.slug()=='others'}"> (<spring:message code="client.allDates"/>)</c:if></h2><div class="dashboard-widget-body"><a class="dashboard-value" href="<c:out value='${clientUrl}'/>">${portfolio.clients()}</a><dl class="dashboard-facts">
<c:forEach items="${['1','2','3']}" var="state"><c:url var="statusUrl" value="/clients/${portfolio.slug()}"><c:if test="${portfolio.slug()!='others'}"><c:param name="financialYearId" value="${overview.selected().id()}"/></c:if><c:param name="paymentStatusId" value="${state}"/></c:url><div><dt><spring:message code="${state=='1'?'status.PAID':state=='2'?'status.UNPAID':'status.PENDING'}"/></dt><dd><a href="<c:out value='${statusUrl}'/>">${state=='1'?portfolio.paid():state=='2'?portfolio.unpaid():portfolio.pending()}</a></dd></div></c:forEach></dl></div></section>
<section class="dashboard-widget" data-dashboard-annual><h2><spring:message code="client.annualFee"/></h2><div class="dashboard-widget-body"><a class="dashboard-value" href="<c:out value='${clientUrl}'/>"><fmt:formatNumber value="${portfolio.annualFee()}" minFractionDigits="2" maxFractionDigits="2"/></a><dl class="dashboard-facts"><div><dt><spring:message code="client.amountPaid"/></dt><dd><fmt:formatNumber value="${portfolio.received()}" minFractionDigits="2" maxFractionDigits="2"/></dd></div><div><dt><spring:message code="${portfolio.category()=='saccos'?'dashboard.annualAfterTax':'dashboard.annualDifference'}"/></dt><dd><fmt:formatNumber value="${portfolio.annualDifference()}" minFractionDigits="2" maxFractionDigits="2"/></dd></div></dl></div></section>
<c:forEach items="${portfolio.fees()}" var="fee"><section class="dashboard-widget" data-dashboard-fee="${fee.reportType()}"><h2><spring:message code="${fee.label()}"/></h2><div class="dashboard-widget-body"><a class="dashboard-value" href="<c:out value='${clientUrl}'/>"><fmt:formatNumber value="${fee.amount()}" minFractionDigits="2" maxFractionDigits="2"/></a></div></section></c:forEach>
</c:forEach>
<c:forEach items="${overview.money()}" var="metric"><section class="dashboard-widget" data-dashboard-money="${metric.key()}"><h2><spring:message code="${metric.label()}"/></h2><div class="dashboard-widget-body"><c:choose><c:when test="${metric.value()!=null}"><a class="dashboard-value" href="<c:url value='${metric.href()}'/>"><fmt:formatNumber value="${metric.value()}" minFractionDigits="2" maxFractionDigits="2"/></a></c:when><c:otherwise><span class="dashboard-value"><spring:message code="gl.presentation.unavailable"/></span></c:otherwise></c:choose></div></section></c:forEach>
</div><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
