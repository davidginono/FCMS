<%@ page pageEncoding="UTF-8" %>
<details class="fs-view-settings"><summary><spring:message code="gl.preview.settings"/></summary><div class="fs-view-fields"><label class="fs-select-setting"><span><spring:message code="gl.preview.font"/></span><select data-fs-font><option value="reference"><spring:message code="gl.preview.reference"/></option><option value="sans">Arial</option><option value="serif">Times New Roman</option><option value="mono">Courier New</option></select></label><label class="fs-select-setting"><span><spring:message code="gl.preview.density"/></span><select data-fs-density><option value="compact"><spring:message code="gl.preview.compact"/></option><option value="comfortable"><spring:message code="gl.preview.comfortable"/></option></select></label><c:if test="${statementDocument.style()=='statement'}"><label><input type="checkbox" checked data-fs-comparison><spring:message code="gl.presentation.showComparison"/></label></c:if></div></details>
