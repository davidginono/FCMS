<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<section class="erp-table-wrap" data-resource-table="${resourceKey}" data-table-selection="single" data-table-page-size="${query.size}" data-table-page-size-options="10 25 50 100">
<div class="app-table-titlebar"><h1><spring:message code="${movements?'gl.equity.movements':'gl.equity.setup'}"/></h1><div class="app-actions"><a class="app-btn btn-neutral" href="<c:url value='/accounting/equity-reporting${movements?"":"/movements"}'/>"><spring:message code="${movements?'gl.equity.setup':'gl.equity.movements'}"/></a><c:if test="${permissions.contains('accounting.setup') and not movements}"><a class="app-btn btn-launch" href="<c:url value='/accounting/equity-reporting/new'/>"><spring:message code="gl.equity.configure"/></a></c:if></div></div>
<form method="get" action="<c:url value='${baseUrl}'/>" class="app-actions"><label><spring:message code="common.search"/><input name="search" type="search" maxlength="100" value="<c:out value='${query.search}'/>"></label><c:if test="${movements}"><label><spring:message code="common.from"/><input type="date" name="from" value="${query.from}"></label><label><spring:message code="common.to"/><input type="date" name="to" value="${query.to}"></label></c:if><input type="hidden" name="sort" value="${query.sort}"><input type="hidden" name="direction" value="${query.direction}"><input type="hidden" name="size" value="${query.size}"><button class="app-btn btn-neutral"><spring:message code="common.apply"/></button></form>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-sort-key="${movements?'id':'id'}" data-table-sort-asc="${movements?'id':'id'}" data-table-sort-desc="${movements?'id':'id'}"><spring:message code="common.id"/></th><th data-table-sort-key="${movements?'date':'maker'}" data-table-sort-asc="${movements?'date':'maker'}" data-table-sort-desc="${movements?'date':'maker'}"><spring:message code="${movements?'common.date':'gl.maker'}"/></th><th data-table-sort-key="${movements?'reference':'reason'}" data-table-sort-asc="${movements?'reference':'reason'}" data-table-sort-desc="${movements?'reference':'reason'}"><spring:message code="${movements?'common.reference':'common.reason'}"/></th><th data-table-sort-key="${movements?'category':'state'}" data-table-sort-asc="${movements?'category':'state'}" data-table-sort-desc="${movements?'category':'state'}"><spring:message code="${movements?'gl.equity.movement':'common.status'}"/></th><th data-table-actions-header><spring:message code="common.actions"/></th></tr></thead><tbody>
<c:forEach items="${records.rows()}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='${movements?"/accounting/journals/":"/accounting/equity-reporting/"}${row.id()}'/>">#<c:out value="${row.id()}"/></a></td><td><c:choose><c:when test="${movements}"><c:out value="${appTime:date(row.date())}"/></c:when><c:otherwise><c:out value="${row.maker()}"/></c:otherwise></c:choose></td><td><c:out value="${movements?row.reference():row.reason()}"/></td><td><spring:message code="${movements?'gl.equity.movement.'.concat(row.category()):'status.'.concat(row.state())}"/></td><td><c:choose><c:when test="${movements}"><c:if test="${permissions.contains('accounting.setup')}"><a class="app-btn btn-neutral" href="<c:url value='/accounting/equity-reporting/movements/${row.id()}'/>"><spring:message code="gl.equity.classify"/></a></c:if></c:when><c:otherwise><a class="app-btn btn-neutral" href="<c:url value='/accounting/equity-reporting/${row.id()}'/>"><spring:message code="common.view"/></a></c:otherwise></c:choose></td></tr></c:forEach>
<c:if test="${empty records.rows()}"><tr><td colspan="5"><spring:message code="common.noRecords"/></td></tr></c:if>
</tbody></table></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %></section>
<%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
