<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="gl.period.details"/></h1></div><section class="erp-resource-section"><h2><spring:message code="common.details"/></h2><div class="fcms-section-body"><dl class="fcms-details"><div><dt><spring:message code="common.name"/></dt><dd><c:out value="${period.name()}"/></dd></div><div><dt><spring:message code="common.from"/></dt><dd><c:out value="${appTime:date(period.startsOn())}"/></dd></div><div><dt><spring:message code="common.to"/></dt><dd><c:out value="${appTime:date(period.endsOn())}"/></dd></div><div><dt><spring:message code="common.status"/></dt><dd><spring:message code="status.${period.state()}"/></dd></div></dl></div></section><%@ include file="/WEB-INF/jsp/accounting/source-coverage.jspf" %><c:if test="${not empty actionError}"><div class="fcms-alert" role="alert"><spring:message code="${actionErrorKey}"/></div></c:if><c:if test="${permissions.contains('accounting.period.close')}"><form class="fcms-form" method="post" action="<c:url value='/accounting/periods/${period.id()}/state'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${period.version()}"><input type="hidden" name="close" value="${period.state()=='OPEN'}"><div class="fcms-field"><label for="reason"><spring:message code="common.reason"/></label><textarea id="reason" name="reason" maxlength="500" required><c:out value="${param.reason}"/></textarea></div><div class="fcms-form-actions"><button class="app-btn btn-launch" type="submit"><spring:message code="${period.state()=='OPEN'?'gl.period.close':'gl.period.reopen'}"/></button></div></form></c:if><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
