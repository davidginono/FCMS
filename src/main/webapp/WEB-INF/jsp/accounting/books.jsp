<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="gl.books"/></h1></div><c:choose><c:when test="${empty book}"><c:if test="${permissions.contains('accounting.setup')}"><a class="app-btn btn-launch" href="<c:url value='/accounting/books/edit'/>"><spring:message code="gl.books.configure"/></a></c:if><div class="fcms-alert" role="status"><spring:message code="gl.unconfigured"/></div></c:when><c:otherwise><section class="erp-resource-section"><h2><spring:message code="gl.books"/></h2><div class="fcms-section-body"><dl class="fcms-details"><div><dt><spring:message code="gl.openingDate"/></dt><dd><c:out value="${appTime:date(book.openingDate())}"/></dd></div><div><dt><spring:message code="gl.policy"/></dt><dd><c:out value="${book.policyReference()}"/></dd></div><div><dt><spring:message code="gl.openingMode"/></dt><dd><spring:message code="gl.opening.${book.openingMode()}"/></dd></div><div><dt><spring:message code="common.status"/></dt><dd><spring:message code="status.${book.state()}"/></dd></div><div><dt><spring:message code="gl.openingBalances"/></dt><dd><spring:message code="${book.ready()?'gl.verified':'gl.pending'}"/></dd></div></dl></div></section><c:if test="${book.state()=='PENDING' and book.makerId()==actorId and permissions.contains('accounting.setup')}"><a class="app-btn btn-neutral" href="<c:url value='/accounting/books/edit'/>"><spring:message code="common.edit"/></a></c:if><c:if test="${book.state()=='PENDING' and book.makerId()!=actorId and permissions.contains('accounting.review')}"><form method="post" action="<c:url value='/accounting/books/approve'/>" class="fcms-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${book.version()}"><div class="fcms-field"><label for="reason"><spring:message code="common.reason"/></label><input id="reason" name="reason" maxlength="500" required></div><button class="app-btn btn-launch" type="submit"><spring:message code="common.approve"/></button></form></c:if></c:otherwise></c:choose><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
