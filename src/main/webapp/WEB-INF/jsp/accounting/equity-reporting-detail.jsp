<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="gl.reporting.revision"/> #<c:out value="${revision.id()}"/></h1></div>
<section class="erp-resource-section"><h2><spring:message code="common.details"/></h2><div class="fcms-section-body"><dl class="fcms-details">
<div><dt><spring:message code="common.status"/></dt><dd><spring:message code="status.${revision.state()}"/></dd></div>
<div><dt><spring:message code="gl.maker"/></dt><dd><c:out value="${revision.maker()}"/></dd></div><div><dt><spring:message code="gl.checker"/></dt><dd><c:out value="${revision.checker()}"/></dd></div>
<div><dt><spring:message code="common.reason"/></dt><dd><c:out value="${revision.reason()}"/></dd></div><div><dt><spring:message code="gl.reviewComment"/></dt><dd><c:out value="${revision.reviewReason()}"/></dd></div>
<c:if test="${not empty revision.baseId()}"><div><dt><spring:message code="gl.equity.previousRevision"/></dt><dd><a href="<c:url value='/accounting/equity-reporting/${revision.baseId()}'/>">#<c:out value="${revision.baseId()}"/></a></dd></div></c:if>
<c:if test="${revision.kind()=='JOURNAL'}"><div><dt><spring:message code="gl.voucherId"/></dt><dd><a href="<c:url value='/accounting/journals/${revision.targetId()}'/>"><c:out value="${revision.targetId()}"/></a></dd></div><div><dt><spring:message code="gl.equity.movement"/></dt><dd><spring:message code="gl.equity.movement.${category}"/></dd></div></c:if>
</dl></div></section>
<c:forEach items="${components}" var="component"><section class="erp-resource-section"><h2><c:out value="${component.name()}"/></h2><div class="fcms-section-body"><dl class="fcms-details"><div><dt><spring:message code="gl.equity.nameSw"/></dt><dd><c:out value="${component.nameSw()}"/></dd></div><div><dt><spring:message code="gl.accounts"/></dt><dd><c:forEach items="${component.accounts()}" var="account"><a href="<c:url value='/accounting/accounts/${account}'/>">#<c:out value="${account}"/></a> </c:forEach></dd></div><div><dt><spring:message code="gl.presentation.retainedEarnings"/></dt><dd><spring:message code="${component.retained()?'common.yes':'common.no'}"/></dd></div></dl></div></section></c:forEach>
<c:if test="${not empty allowedActions}"><c:url var="decisionUrl" value="/accounting/equity-reporting/${revision.id()}/decision"/><form:form modelAttribute="decisionForm" method="post" action="${decisionUrl}" cssClass="fcms-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="version"/>
<fieldset class="fcms-form-section"><legend><spring:message code="gl.review"/></legend><div class="fcms-field"><label for="reason"><spring:message code="common.reason"/></label><form:textarea id="reason" path="reason" maxlength="500" required="required"/><form:errors path="reason" cssClass="fcms-error"/></div></fieldset><form:errors path="" element="div" cssClass="fcms-alert" role="alert"/><div class="fcms-form-actions"><c:forEach items="${allowedActions}" var="action"><button class="app-btn btn-neutral" name="action" value="${action}"><spring:message code="common.${action}"/></button></c:forEach></div></form:form></c:if>
<a class="app-btn btn-neutral" href="<c:url value='/accounting/equity-reporting'/>"><spring:message code="common.back"/></a>
<%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
