<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<section class="erp-table-wrap" data-resource-table="${resourceKey}" data-table-selection="single" data-table-page-size="${query.size}" data-table-page-size-options="10 25 50 100"><div class="app-table-titlebar"><h2><spring:message code="gl.journals"/></h2><c:if test="${permissions.contains('accounting.write') and journalKind!='REVERSAL'}"><c:url var="createJournalUrl" value="/accounting/journals/new"><c:param name="kind" value="${empty journalKind?'JOURNAL':journalKind}"/></c:url><a class="app-btn btn-launch" href="<c:out value='${createJournalUrl}'/>"><spring:message code="common.create"/></a></c:if></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-filters.jspf" %><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-sort-key="date" data-table-sort-asc="date" data-table-sort-desc="date"><spring:message code="common.date"/></th><th data-table-sort-key="reference" data-table-sort-asc="reference" data-table-sort-desc="reference"><spring:message code="common.reference"/></th><th data-table-sort-key="kind" data-table-sort-asc="kind" data-table-sort-desc="kind"><spring:message code="gl.kind"/></th><th data-table-sort-key="amount" data-table-sort-asc="amount" data-table-sort-desc="amount"><spring:message code="common.amount"/></th><th data-table-sort-key="maker" data-table-sort-asc="maker" data-table-sort-desc="maker"><spring:message code="gl.maker"/></th><th data-table-sort-key="status" data-table-sort-asc="status" data-table-sort-desc="status"><spring:message code="common.status"/></th><th data-table-actions-header><spring:message code="common.actions"/></th></tr></thead><tbody><c:forEach items="${records.rows()}" var="row"><tr><td><c:out value="${appTime:date(row.date())}"/></td><td><a class="resource-table-id-link" href="<c:url value='/accounting/journals/${row.id()}'/>"><c:out value="${row.reference()}"/></a></td><td><spring:message code="gl.kind.${row.kind()}"/></td><td><c:out value="${row.total()}"/></td><td><c:out value="${row.maker()}"/></td><td><spring:message code="status.${row.state()}"/></td><td><a class="app-btn btn-neutral" href="<c:url value='${baseUrl}/${row.id()}'/>"><spring:message code="common.view"/></a></td></tr></c:forEach><c:if test="${empty records.rows()}"><tr><td colspan="7"><spring:message code="common.noRecords"/></td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %></section><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
