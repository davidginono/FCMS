<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>

<link rel="stylesheet" href="<c:url value='/css/financial-statements.css?v=20261103'/>">
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="${reportTitle}"/></h1></div>
<c:url var="previewUrl" value="/accounting/statements/${reportType}"><c:param name="from" value="${query.from}"/><c:param name="to" value="${query.to}"/></c:url><c:url var="lineUrl" value="/accounting/statements/${reportType}/lines/${statementLine}"><c:param name="from" value="${query.from}"/><c:param name="to" value="${query.to}"/></c:url>
<nav class="app-actions" aria-label="<spring:message code='common.breadcrumb'/>"><a class="app-btn btn-neutral" href="<c:out value='${previewUrl}'/>"><spring:message code="gl.preview"/></a><c:if test="${not empty entries}"><a class="app-btn btn-neutral" href="<c:out value='${lineUrl}'/>"><spring:message code="gl.drill.accounts"/></a></c:if></nav>
<c:if test="${not empty entries}"><c:url var="ledgerFullUrl" value="/accounting/accounts/${account.id()}/ledger"><c:param name="from" value="${query.from}"/><c:param name="to" value="${query.to}"/></c:url><a class="app-btn btn-neutral" href="<c:out value='${ledgerFullUrl}'/>"><spring:message code="gl.generalLedger"/></a></c:if><c:if test="${empty entries}"><c:url var="drillPdfUrl" value="${baseUrl}/print.pdf"><c:param name="from" value="${query.from}"/><c:param name="to" value="${query.to}"/><c:param name="search" value="${query.search}"/></c:url><c:url var="drillPrintUrl" value="${baseUrl}/print"><c:param name="from" value="${query.from}"/><c:param name="to" value="${query.to}"/><c:param name="search" value="${query.search}"/></c:url><div class="app-actions"><a class="app-btn btn-neutral" href="<c:out value='${drillPdfUrl}'/>"><spring:message code="common.pdf"/></a><a class="app-btn btn-neutral" href="<c:out value='${drillPrintUrl}'/>"><spring:message code="common.print"/></a></div></c:if><form class="app-actions" method="get" action="<c:url value='${baseUrl}'/>"><input type="hidden" name="from" value="${query.from}"><input type="hidden" name="to" value="${query.to}"><label><spring:message code="common.search"/><input type="search" name="search" maxlength="100" value="<c:out value='${query.search}'/>"></label><label><spring:message code="gl.drill.pageSize"/><select name="size"><c:forTokens items="10,25,50,100" delims="," var="size"><option value="${size}" ${query.size==size?'selected':''}>${size}</option></c:forTokens></select></label><button class="app-btn btn-neutral" type="submit"><spring:message code="common.apply"/></button></form>
<%@ include file="/WEB-INF/jsp/accounting/statement-paper.jspf" %><c:if test="${not empty entries}"><details class="erp-resource-section"><summary><spring:message code="gl.drill.entries"/></summary><div class="fcms-section-body erp-table-scroll"><table class="fs-table" data-table-sort-mode="none" data-table-sort-reason="financial-statement"><thead><tr><c:choose><c:when test="${empty entries}"><th><spring:message code="gl.code"/></th><th><spring:message code="gl.account"/></th><th class="fs-details"><spring:message code="common.details"/></th></c:when><c:otherwise><th><spring:message code="common.date"/></th><th><spring:message code="gl.voucherId"/></th><th><spring:message code="common.reference"/></th><th><spring:message code="common.description"/></th><th class="fs-number"><spring:message code="gl.debit"/></th><th class="fs-number"><spring:message code="gl.credit"/></th></c:otherwise></c:choose><th class="fs-number"><spring:message code="gl.drill.contribution"/></th></tr></thead><tbody>
<c:forEach items="${records.rows()}" var="row"><tr><c:choose><c:when test="${empty entries}"><td><c:out value="${row.code()}"/></td><td><c:out value="${row.name()}"/></td><td class="fs-details"><c:url var="entriesUrl" value="/accounting/statements/${reportType}/lines/${statementLine}/accounts/${row.id()}"><c:param name="from" value="${query.from}"/><c:param name="to" value="${query.to}"/></c:url><a class="fs-details-button" href="<c:out value='${entriesUrl}'/>"><spring:message code="common.details"/><span class="sr-only"> <c:out value="${row.code()}"/></span></a></td></c:when><c:otherwise><td><c:out value="${appTime:date(row.date())}"/></td><td><a class="resource-table-id-link" href="<c:url value='/accounting/journals/${row.journalId()}'/>"><c:out value="${row.journalId()}"/></a></td><td><c:out value="${row.reference()}"/></td><td><c:out value="${row.description()}"/></td><td class="fs-number"><fmt:formatNumber value="${row.debit()}" minFractionDigits="2" maxFractionDigits="2"/></td><td class="fs-number"><fmt:formatNumber value="${row.credit()}" minFractionDigits="2" maxFractionDigits="2"/></td></c:otherwise></c:choose><td class="fs-number"><fmt:formatNumber value="${row.amount()}" minFractionDigits="2" maxFractionDigits="2"/></td></tr></c:forEach>
<c:if test="${empty records.rows()}"><tr><td colspan="${empty entries?4:7}"><spring:message code="common.noRecords"/></td></tr></c:if>
<tr class="fs-total"><td colspan="${empty entries?3:6}"><spring:message code="gl.drill.total"/></td><td class="fs-number"><fmt:formatNumber value="${total}" minFractionDigits="2" maxFractionDigits="2"/></td></tr>
<c:if test="${not empty query.search}"><tr class="fs-total"><td colspan="${empty entries?3:6}"><spring:message code="gl.drill.filtered"/></td><td class="fs-number"><fmt:formatNumber value="${filteredTotal}" minFractionDigits="2" maxFractionDigits="2"/></td></tr></c:if>
</tbody></table></div></details></c:if>
<section class="erp-resource-section"><h2><spring:message code="gl.drill.contribution"/></h2><div class="fcms-section-body"><dl class="fcms-details"><div><dt><c:choose><c:when test="${statementLineLabelKey}"><spring:message code="${statementLineLabel}"/></c:when><c:otherwise><c:out value="${statementLineLabel}"/></c:otherwise></c:choose></dt><dd><fmt:formatNumber value="${total}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div><c:if test="${not empty query.search}"><div><dt><spring:message code="gl.drill.filtered"/></dt><dd><fmt:formatNumber value="${filteredTotal}" minFractionDigits="2" maxFractionDigits="2"/> TZS</dd></div></c:if></dl></div></section><div class="fs-pager"><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %></div>
<c:set var="sourceCoverage" value="${statement.sourceCoverage()}"/><%@ include file="/WEB-INF/jsp/accounting/source-coverage.jspf" %>
<%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
