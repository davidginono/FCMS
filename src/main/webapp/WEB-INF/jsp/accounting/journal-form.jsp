<div class="app-page-header"><h1 class="app-page-title"><spring:message code="gl.voucher.create"/></h1></div><c:url var="saveUrl" value="${formAction}"/><form:form modelAttribute="form" method="post" action="${saveUrl}" cssClass="fcms-form" data-resource-form-page="true"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="version"/><form:hidden path="requestKey"/><form:hidden path="kind"/><section class="erp-resource-section"><h2><spring:message code="common.details"/></h2><div class="fcms-section-body"><dl class="fcms-details"><div><dt><spring:message code="gl.kind"/></dt><dd><spring:message code="gl.kind.${form.kind}"/></dd></div></dl><ui:field path="date" label="common.date" type="date"/><ui:field path="reference" label="common.reference" type="text"/><ui:field path="evidenceReference" label="gl.evidence" type="text"/><div class="fcms-field"><label for="description"><spring:message code="common.description"/></label><form:textarea path="description" id="description" maxlength="1000"/><form:errors path="description" cssClass="fcms-error"/></div><div class="fcms-field"><label for="cashFlow"><spring:message code="gl.cashFlowClassification"/></label><form:select path="cashFlow" id="cashFlow"><c:forTokens items="NONE,OPERATING,INVESTING,FINANCING,INTERNAL" delims="," var="flow"><form:option value="${flow}"><spring:message code="gl.flow.${flow}"/></form:option></c:forTokens></form:select></div></div></section><section class="erp-resource-section"><h2><spring:message code="gl.lines"/></h2><div class="fcms-section-body"><div class="gl-lines" data-journal-lines><c:forEach items="${form.lines}" var="line" varStatus="rowStatus"><fieldset class="gl-line" data-journal-line><legend><spring:message code="gl.line"/> <span data-line-number>${rowStatus.index+1}</span></legend><div class="gl-line-fields"><div class="fcms-field"><label for="lines${rowStatus.index}account"><spring:message code="gl.account"/></label><form:select path="lines[${rowStatus.index}].accountId" id="lines${rowStatus.index}account" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=true"><form:option value=""/><form:options items="${accounts}" itemValue="id" itemLabel="name"/></form:select><form:errors path="lines[${rowStatus.index}].accountId" cssClass="fcms-error"/></div><div class="fcms-field"><label for="lines${rowStatus.index}debit"><spring:message code="gl.debit"/></label><form:input path="lines[${rowStatus.index}].debit" id="lines${rowStatus.index}debit" type="number" min="0" step="0.01" data-journal-debit="true"/><form:errors path="lines[${rowStatus.index}].debit" cssClass="fcms-error"/></div><div class="fcms-field"><label for="lines${rowStatus.index}credit"><spring:message code="gl.credit"/></label><form:input path="lines[${rowStatus.index}].credit" id="lines${rowStatus.index}credit" type="number" min="0" step="0.01" data-journal-credit="true"/><form:errors path="lines[${rowStatus.index}].credit" cssClass="fcms-error"/></div></div><div class="fcms-field"><label for="lines${rowStatus.index}description"><spring:message code="common.description"/></label><form:input path="lines[${rowStatus.index}].description" id="lines${rowStatus.index}description" maxlength="500"/></div><button type="button" class="app-btn btn-neutral" data-line-remove><spring:message code="common.remove"/></button></fieldset></c:forEach></div><button type="button" class="app-btn btn-neutral" data-line-add><spring:message code="gl.addLine"/></button><dl class="fcms-details"><div><dt><spring:message code="gl.debitTotal"/></dt><dd><output data-debit-total>—</output></dd></div><div><dt><spring:message code="gl.creditTotal"/></dt><dd><output data-credit-total>—</output></dd></div></dl></div></section><form:errors path="" element="div" cssClass="fcms-alert" role="alert"/><div class="fcms-form-actions"><a class="app-btn btn-neutral" href="<c:url value='/accounting/journals'/>"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit"><spring:message code="gl.saveDraft"/></button></div></form:form><template id="journal-line-template"><fieldset class="gl-line" data-journal-line><legend><spring:message code="gl.line"/> <span data-line-number></span></legend><div class="gl-line-fields"><div class="fcms-field"><label for="lines__index__account"><spring:message code="gl.account"/></label><select name="lines[__index__].accountId" id="lines__index__account" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=true"><option value=""></option><c:forEach items="${accounts}" var="a"><option value="${a.id()}"><c:out value="${a.name()}"/></option></c:forEach></select></div><div class="fcms-field"><label for="lines__index__debit"><spring:message code="gl.debit"/></label><input name="lines[__index__].debit" id="lines__index__debit" type="number" min="0" step="0.01" data-journal-debit="true"/></div><div class="fcms-field"><label for="lines__index__credit"><spring:message code="gl.credit"/></label><input name="lines[__index__].credit" id="lines__index__credit" type="number" min="0" step="0.01" data-journal-credit="true"/></div></div><div class="fcms-field"><label for="lines__index__description"><spring:message code="common.description"/></label><input name="lines[__index__].description" id="lines__index__description" maxlength="500"/></div><button type="button" class="app-btn btn-neutral" data-line-remove><spring:message code="common.remove"/></button></fieldset></template><script defer src="<c:url value='/js/journal-form.js?v=fcms-modules-20261103-accounting1'/>"></script><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
