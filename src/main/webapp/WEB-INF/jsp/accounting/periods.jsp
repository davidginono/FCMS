<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<section class="erp-table-wrap" data-resource-table="${resourceKey}" data-table-selection="single" data-table-page-size="${query.size}" data-table-page-size-options="10 25 50 100"><div class="app-table-titlebar"><h2><spring:message code="gl.periods"/></h2><c:if test="${permissions.contains('accounting.setup')}"><a class="app-btn btn-launch" href="<c:url value='/accounting/periods/new'/>"><spring:message code="common.create"/></a></c:if></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-filters.jspf" %><div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-sort-key="name" data-table-sort-asc="name" data-table-sort-desc="name"><spring:message code="common.name"/></th><th data-table-sort-key="from" data-table-sort-asc="from" data-table-sort-desc="from"><spring:message code="common.from"/></th><th data-table-sort-key="to" data-table-sort-asc="to" data-table-sort-desc="to"><spring:message code="common.to"/></th><th data-table-sort-key="status" data-table-sort-asc="status" data-table-sort-desc="status"><spring:message code="common.status"/></th><th data-table-actions-header><spring:message code="common.actions"/></th></tr></thead><tbody><c:forEach items="${records.rows()}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='/accounting/periods/${row.id()}'/>"><c:out value="${row.name()}"/></a></td><td><c:out value="${appTime:date(row.startsOn())}"/></td><td><c:out value="${appTime:date(row.endsOn())}"/></td><td><spring:message code="status.${row.state()}"/></td><td><a class="app-btn btn-neutral" href="<c:url value='${baseUrl}/${row.id()}'/>"><spring:message code="common.view"/></a></td></tr></c:forEach><c:if test="${empty records.rows()}"><tr><td colspan="5"><spring:message code="common.noRecords"/></td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %></section><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
