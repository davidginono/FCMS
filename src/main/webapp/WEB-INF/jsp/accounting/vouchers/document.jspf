<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${empty voucherHeader}"><%@ include file="historical-document.jspf" %></c:when><c:otherwise>
<link rel="stylesheet" href="<c:url value='/css/voucher-document.css?v=20261103'/>">
<article class="voucher-document"><header class="voucher-document-header"><div class="voucher-institution">FCMS</div><div><h2><spring:message code="gl.kind.${journal.kind()}"/></h2><div><c:out value="${voucherHeader.number()}"/></div><span class="voucher-status"><spring:message code="status.${journal.state()}"/></span></div></header>
<dl class="voucher-metadata"><div><dt><spring:message code="common.date"/></dt><dd><c:out value="${appTime:date(journal.date())}"/></dd></div><div><dt><spring:message code="common.reference"/></dt><dd><c:out value="${journal.reference()}"/></dd></div><c:if test="${not empty voucherHeader.party()}"><div><dt><spring:message code="${journal.kind()=='RECEIPT'?'voucher.receivedFrom':'voucher.paidTo'}"/></dt><dd><c:out value="${voucherHeader.party()}"/></dd></div></c:if><c:if test="${not empty voucherHeader.clientName()}"><div><dt><spring:message code="common.client"/></dt><dd><c:out value="${voucherHeader.clientName()}"/></dd></div></c:if></dl>
<div class="erp-table-scroll"><table class="erp-table voucher-lines" data-table-sort-mode="none" data-table-sort-reason="document"><thead><tr><th>#</th><th><spring:message code="common.description"/></th><th><spring:message code="gl.mapping.debitAccount"/></th><th><spring:message code="gl.mapping.creditAccount"/></th><th><spring:message code="common.amount"/></th></tr></thead><tbody><c:forEach items="${voucherRows}" var="row"><c:forEach items="${row.postings()}" var="entry"><tr><td>${row.ordinal()}</td><td><c:out value="${row.description()}"/><c:if test="${not empty row.transactionName()}"><div><c:out value="${row.transactionName()}"/> · <spring:message code="voucher.component.${row.component()}"/></div></c:if></td><td><c:if test="${entry.side()=='DEBIT'}"><c:out value="${entry.account().name()}"/></c:if></td><td><c:if test="${entry.side()=='CREDIT'}"><c:out value="${entry.account().name()}"/></c:if></td><td><fmt:formatNumber value="${entry.amount()}" minFractionDigits="2" maxFractionDigits="2"/></td></tr></c:forEach></c:forEach></tbody></table></div>
<div class="voucher-document-total"><spring:message code="voucher.total"/> (TZS) <strong><fmt:formatNumber value="${journal.total()}" minFractionDigits="2" maxFractionDigits="2"/></strong></div>
<dl class="voucher-metadata"><div><dt><spring:message code="gl.document.amountWords"/></dt><dd><c:out value="${voucherDocument.words()}"/></dd></div><div><dt><spring:message code="common.description"/></dt><dd><c:out value="${journal.description()}"/></dd></div><div><dt><spring:message code="gl.maker"/></dt><dd><c:out value="${journal.maker()}"/></dd></div><div><dt><spring:message code="gl.checker"/></dt><dd><c:out value="${journal.checker()}"/></dd></div><div><dt><spring:message code="gl.document.postedAt"/></dt><dd><c:out value="${appTime:display(voucherDocument.postedAt())}"/></dd></div></dl>
<c:if test="${not empty journal.reversedBy()}"><a class="resource-table-id-link" href="<c:url value='/accounting/journals/${journal.reversedBy()}'/>"><spring:message code="ledger.reversedBy"/> #${journal.reversedBy()}</a></c:if>
</article></c:otherwise></c:choose>
