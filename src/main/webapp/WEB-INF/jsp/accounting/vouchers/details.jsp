<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-entry.css?v=20261118-split2'/>">
<c:if test="${not empty voucherHeader}"><nav class="erp-page-path" aria-label="<spring:message code='common.breadcrumb'/>"><a href="<c:url value='${baseUrl}'/>"><spring:message code="voucher.register.${voucherKind}"/></a><span aria-hidden="true">›</span><span aria-current="page"><c:out value="${voucherHeader.number()}"/></span></nav></c:if>
<c:choose><c:when test="${empty voucherHeader}"><c:url var="voucherPdfUrl" value="/accounting/journals/${journal.id()}/print.pdf"/><c:set var="voucherPrintUrl" value="${voucherPdfUrl}"/></c:when><c:otherwise><c:url var="voucherPdfUrl" value="${baseUrl}/${journal.id()}/pdf"/><c:url var="voucherPrintUrl" value="${baseUrl}/${journal.id()}/print"/></c:otherwise></c:choose>
<div class="app-page-header" data-voucher-kind="${journal.kind()}"><h1 class="app-page-title"><spring:message code="gl.voucher.details"/></h1>
<div class="app-actions"><c:if test="${not empty ledgerReturn}"><c:url var="ledgerBackUrl" value="/accounting/accounts/${ledgerReturn.accountId()}/ledger"><c:param name="from" value="${ledgerReturn.from()}"/><c:param name="to" value="${ledgerReturn.to()}"/></c:url><a class="app-btn btn-neutral" href="<c:out value='${ledgerBackUrl}'/>"><spring:message code="gl.ledger.return"/></a></c:if><c:if test="${permissions.contains('accounting.report')}"><a class="app-btn btn-neutral" target="_blank" rel="noopener" href="${voucherPrintUrl}"><ui:reportExport format="print"/></a><a class="app-btn btn-neutral" target="_blank" rel="noopener" href="${voucherPdfUrl}"><ui:reportExport format="pdf"/></a></c:if></div>
</div><%@ include file="document.jspf" %><c:if test="${not empty sourceBinding and permissions.contains('finance.gl-source.read')}"><section class="erp-resource-section"><h2><spring:message code="gl.source"/></h2><div class="fcms-section-body"><a class="resource-table-id-link" href="<c:url value='/accounting/sources/${sourceBinding.kind()}/${sourceBinding.sourceId()}'/>"><spring:message code="gl.source.kind.${sourceBinding.kind()}"/> #<c:out value="${sourceBinding.sourceId()}"/></a></div></section></c:if><c:if test="${not empty actionError}"><div role="alert" class="fcms-alert"><spring:message code="error.conflict"/></div></c:if><c:if test="${journal.makerId()==actorId and (journal.state()=='DRAFT' or journal.state()=='REJECTED') and permissions.contains('accounting.write')}"><section class="erp-resource-section"><h2><spring:message code="gl.review"/></h2><div class="fcms-section-body"><form method="post" class="fcms-command" action="<c:url value='${actionBase}/actions/submit'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${journal.version()}"><button class="app-btn btn-launch" type="submit"><spring:message code="common.submit"/></button></form><c:if test="${journal.kind()!='REVERSAL'}"><form method="post" class="fcms-command" action="<c:url value='${actionBase}/actions/cancel'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${journal.version()}"><div class="fcms-field"><label for="cancelReason"><spring:message code="common.reason"/></label><textarea id="cancelReason" name="reason" maxlength="500" required><c:out value="${param.reason}"/></textarea></div><button class="app-btn btn-neutral" type="submit"><spring:message code="common.cancel"/></button></form></c:if></div></section></c:if><c:if test="${journal.state()=='SUBMITTED' and journal.makerId()!=actorId and sourceReviewAllowed and permissions.contains('accounting.review')}"><section class="erp-resource-section"><h2><spring:message code="gl.review"/></h2><div class="fcms-section-body"><form method="post" class="fcms-command" action="<c:url value='${actionBase}/actions/post'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${journal.version()}"><div class="fcms-field"><label for="postReason"><spring:message code="common.reason"/></label><textarea id="postReason" name="reason" maxlength="500" required><c:out value="${param.reason}"/></textarea></div><button class="app-btn btn-launch" type="submit"><spring:message code="gl.post"/></button></form><form method="post" class="fcms-command" action="<c:url value='${actionBase}/actions/reject'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${journal.version()}"><div class="fcms-field"><label for="rejectReason"><spring:message code="common.reason"/></label><textarea id="rejectReason" name="reason" maxlength="500" required><c:out value="${param.reason}"/></textarea></div><button class="app-btn btn-neutral" type="submit"><spring:message code="common.reject"/></button></form></div></section></c:if><c:if test="${journal.state()=='POSTED' and journal.makerId()!=actorId and empty journal.reversedBy() and journal.kind()!='OPENING' and journal.kind()!='REVERSAL' and not journal.sourceLinked() and permissions.contains('accounting.reverse')}"><section class="erp-resource-section"><h2><spring:message code="ledger.reverse"/></h2><div class="fcms-section-body"><form method="post" action="<c:url value='${actionBase}/reverse'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="requestKey" value="${requestKey}"><div class="fcms-field"><label for="reversalDate"><spring:message code="common.date"/></label><input id="reversalDate" name="date" type="date" required></div><div class="fcms-field"><label for="reversalReason"><spring:message code="common.reason"/></label><textarea id="reversalReason" name="reason" maxlength="500" required><c:out value="${param.reason}"/></textarea></div><button type="submit" class="app-btn btn-launch"><spring:message code="gl.requestReversal"/></button></form></div></section></c:if><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
