<%@ page pageEncoding="UTF-8" %>
<link rel="stylesheet" href="<c:url value='/css/voucher-document.css?v=20261103'/>">
<article class="voucher-document"><header class="voucher-document-header"><div><div class="voucher-institution">FCMS</div><dl><dt><spring:message code="gl.voucherId"/></dt><dd>#<c:out value="${journal.id()}"/></dd></dl></div><div><h2><spring:message code="gl.kind.${journal.kind()}"/></h2><span class="voucher-status"><spring:message code="status.${journal.state()}"/></span></div></header>
<dl class="voucher-metadata"><div><dt><spring:message code="common.date"/></dt><dd><c:out value="${appTime:date(journal.date())}"/></dd></div><div><dt><spring:message code="common.reference"/></dt><dd><c:out value="${journal.reference()}"/></dd></div><div><dt><spring:message code="gl.evidence"/></dt><dd><c:out value="${journal.evidenceReference()}"/></dd></div><div><dt><spring:message code="gl.cashFlowClassification"/></dt><dd><spring:message code="gl.flow.${journal.cashFlow()}"/></dd></div></dl>
<div class="erp-table-scroll"><table class="erp-table voucher-lines" data-table-sort-mode="none" data-table-sort-reason="document"><thead><tr><th>#</th><th><spring:message code="gl.account"/></th><th><spring:message code="common.description"/></th><th class="voucher-numeric"><spring:message code="gl.debit"/></th><th class="voucher-numeric"><spring:message code="gl.credit"/></th></tr></thead><tbody><c:forEach items="${journal.lines()}" var="line" varStatus="n"><tr><td>${n.index+1}</td><td><c:out value="${line.accountCode()}"/> · <c:out value="${line.accountName()}"/></td><td><c:out value="${line.description()}"/></td><td class="voucher-numeric"><fmt:formatNumber value="${line.debit()}" minFractionDigits="2" maxFractionDigits="2"/></td><td class="voucher-numeric"><fmt:formatNumber value="${line.credit()}" minFractionDigits="2" maxFractionDigits="2"/></td></tr></c:forEach></tbody></table></div>
<dl class="voucher-metadata"><div><dt><spring:message code="gl.document.amountWords"/></dt><dd><c:out value="${voucherDocument.words()}"/></dd></div><div><dt><spring:message code="gl.document.totalDebit"/> / <spring:message code="gl.document.totalCredit"/> (TZS)</dt><dd><fmt:formatNumber value="${journal.total()}" minFractionDigits="2" maxFractionDigits="2"/></dd></div></dl>
<div class="voucher-document-total"><spring:message code="gl.document.totalAmount"/> (TZS)<strong><fmt:formatNumber value="${voucherDocument.amount()}" minFractionDigits="2" maxFractionDigits="2"/></strong></div>
<h3><spring:message code="gl.document.narration"/></h3><div><c:out value="${journal.description()}"/></div>
<h3><spring:message code="gl.document.postingRecord"/></h3><dl class="voucher-metadata voucher-records"><div><dt><spring:message code="gl.maker"/></dt><dd><c:out value="${journal.maker()}"/> #<c:out value="${journal.makerId()}"/></dd></div><div><dt><spring:message code="gl.checker"/></dt><dd><c:out value="${journal.checker()}"/> <c:if test="${not empty journal.checkerId()}">#<c:out value="${journal.checkerId()}"/></c:if></dd></div><div><dt><spring:message code="gl.document.postedAt"/></dt><dd><c:out value="${appTime:display(voucherDocument.postedAt())}"/></dd></div><div><dt><spring:message code="gl.review"/></dt><dd><c:out value="${journal.reviewComment()}"/></dd></div></dl>
<c:if test="${not empty journal.reversesId()}"><dl><dt><spring:message code="ledger.reversalOf"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/journals/${journal.reversesId()}'/>">#<c:out value="${journal.reversesId()}"/></a></dd></dl></c:if><c:if test="${not empty journal.reversedBy()}"><dl><dt><spring:message code="ledger.reversedBy"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/journals/${journal.reversedBy()}'/>">#<c:out value="${journal.reversedBy()}"/></a></dd></dl></c:if>
</article>
