<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>

<div class="app-page-header"><h1 class="app-page-title"><spring:message code="gl.source.details"/></h1></div>
<section class="erp-resource-section"><h2><spring:message code="gl.source"/></h2><div class="fcms-section-body"><dl class="fcms-details">
 <div><dt><spring:message code="common.reference"/></dt><dd><c:out value="${source.id()}"/></dd></div><div><dt><spring:message code="gl.source.kind"/></dt><dd><spring:message code="gl.source.kind.${source.kind()}"/></dd></div><div><dt><spring:message code="gl.source.reference"/></dt><dd><c:out value="${source.reference()}"/></dd></div><div><dt><spring:message code="common.date"/></dt><dd><c:out value="${appTime:date(source.date())}"/></dd></div><div><dt><spring:message code="gl.source.amount"/></dt><dd><c:out value="${source.signedAmount()}"/></dd></div><div><dt><spring:message code="gl.source.state"/></dt><dd><spring:message code="status.${source.state()}"/></dd></div><div><dt><spring:message code="gl.source.coverage"/></dt><dd><spring:message code="status.${item.coverage()}"/></dd></div><div><dt><spring:message code="gl.source.actor"/></dt><dd><c:out value="${source.actorId()}"/></dd></div><div><dt><spring:message code="common.description"/></dt><dd><c:out value="${source.description()}"/></dd></div>
 <c:if test="${not empty source.reversesId()}"><div><dt><spring:message code="ledger.reversalOf"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/sources/${source.reversesKind()}/${source.reversesId()}'/>"><c:out value="${source.reversesId()}"/></a></dd></div></c:if>
 <c:if test="${not empty item.journalId()}"><div><dt><spring:message code="gl.voucherId"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/journals/${item.journalId()}'/>"><c:out value="${item.journalId()}"/></a></dd></div></c:if>
 </dl></div></section>
 <c:if test="${not empty mapping}"><section class="erp-resource-section"><h2><spring:message code="config.template"/></h2><div class="fcms-section-body"><dl class="fcms-details">
 <div><dt><spring:message code="config.transaction"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/config/transactions/${mapping.transactionId()}'><c:param name='review' value='${mapping.id()}'/></c:url>"><c:out value="${mapping.transactionCode()}"/></a></dd></div>
 <div><dt><spring:message code="config.event"/></dt><dd><spring:message code="gl.event.${mapping.event()}"/></dd></div>
 <div><dt><spring:message code="gl.policy"/></dt><dd><c:out value="${mapping.policyReference()}"/></dd></div>
 <div><dt><spring:message code="gl.cashFlowClassification"/></dt><dd><spring:message code="gl.flow.${mapping.cashFlow()}"/></dd></div>
 <c:if test="${not workspace.exactReversal}">
 <div><dt><spring:message code="gl.mapping.debitAccount"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/accounts/${mapping.debitAccountId()}'/>"><c:out value="${mapping.debitAccount()}"/></a></dd></div>
 <div><dt><spring:message code="gl.mapping.creditAccount"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/accounts/${mapping.creditAccountId()}'/>"><c:out value="${mapping.creditAccount()}"/></a></dd></div><div><dt><spring:message code="gl.kind"/></dt><dd><spring:message code="gl.kind.${mapping.voucherKind()}"/></dd></div>
 </c:if></dl></div></section></c:if>
 <c:if test="${workspace.exactReversal and not empty workspace.original}"><section class="erp-resource-section"><h2><spring:message code="gl.source.reversalLines"/></h2><div class="fcms-section-body">
 <a class="resource-table-id-link" href="<c:url value='/accounting/journals/${workspace.original.id()}'/>"><spring:message code="gl.source.originalVoucher"/> #<c:out value="${workspace.original.id()}"/></a>
 <div class="erp-table-scroll"><table class="erp-table"><thead><tr><th><spring:message code="gl.code"/></th><th><spring:message code="gl.account"/></th><th><spring:message code="gl.debit"/></th><th><spring:message code="gl.credit"/></th></tr></thead><tbody><c:forEach items="${workspace.original.lines()}" var="line"><tr><td><c:out value="${line.accountCode()}"/></td><td><c:out value="${line.accountName()}"/></td><td><c:out value="${line.credit()}"/></td><td><c:out value="${line.debit()}"/></td></tr></c:forEach></tbody></table></div></div></section></c:if>
 <c:if test="${(workspace.preparable and permissions.contains('accounting.write') and (not workspace.exactReversal or permissions.contains('accounting.reverse'))) or not empty prepareError}"><section class="erp-resource-section"><h2><spring:message code="gl.source.prepare"/></h2><div class="fcms-section-body">
 <c:url var="prepareUrl" value="/accounting/sources/${source.kind()}/${source.id()}/prepare"/>
 <form:form modelAttribute="form" method="post" action="${prepareUrl}" cssClass="fcms-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><c:choose><c:when test="${workspace.exactReversal}"><input type="hidden" name="mappingId" value="${item.mappingId()}"></c:when><c:otherwise><div class="fcms-field"><label for="mappingId"><spring:message code="config.transaction"/></label><form:select path="mappingId" id="mappingId" data-choice-url="${pageContext.request.contextPath}/accounting/config/transactions/choices?event=${item.mappingEvent()}"><form:option value=""/><form:options items="${templates}" itemValue="id" itemLabel="name"/></form:select><form:errors path="mappingId" cssClass="fcms-error"/></div></c:otherwise></c:choose><input type="hidden" name="requestKey" value="${preparationKey}">
 <div class="fcms-field"><label for="evidenceReference"><spring:message code="gl.evidence"/></label><form:input path="evidenceReference" id="evidenceReference" maxlength="200" readonly="${not workspace.preparable}"/><form:errors path="evidenceReference" cssClass="fcms-error"/></div>
 <form:errors path="" element="div" cssClass="fcms-alert" role="alert"/>
 <c:if test="${workspace.preparable and permissions.contains('accounting.write') and (not workspace.exactReversal or permissions.contains('accounting.reverse'))}"><div class="fcms-form-actions"><button class="app-btn btn-launch" type="submit"><spring:message code="gl.source.prepare"/></button></div></c:if>
 </form:form></div></section></c:if>
 <section class="erp-table-wrap" data-resource-table="${resourceKey}" data-table-selection="single" data-table-page-size="${query.size}" data-table-page-size-options="10 25 50 100">
 <div class="app-table-titlebar"><h2><spring:message code="gl.source.attempts"/></h2></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-filters.jspf" %>
 <div class="erp-table-scroll"><table class="erp-table"><thead><tr><th data-table-sort-key="id" data-table-sort-asc="id" data-table-sort-desc="id"><spring:message code="gl.voucherId"/></th><th data-table-sort-key="mapping" data-table-sort-asc="mapping" data-table-sort-desc="mapping"><spring:message code="config.transaction"/></th><th data-table-sort-key="evidence" data-table-sort-asc="evidence" data-table-sort-desc="evidence"><spring:message code="gl.evidence"/></th><th data-table-sort-key="status" data-table-sort-asc="status" data-table-sort-desc="status"><spring:message code="common.status"/></th><th data-table-sort-key="date" data-table-sort-asc="date" data-table-sort-desc="date"><spring:message code="gl.mapping.createdAt"/></th><th data-table-sort-key="maker" data-table-sort-asc="maker" data-table-sort-desc="maker"><spring:message code="gl.maker"/></th><th data-table-actions-header><spring:message code="common.actions"/></th></tr></thead><tbody>
 <c:forEach items="${records.rows()}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='/accounting/journals/${row.id()}'/>"><c:out value="${row.id()}"/></a></td><td><c:if test="${not empty row.mappingId()}"><a class="resource-table-id-link" href="<c:url value='/accounting/config/transactions/${row.transactionId()}'><c:param name='review' value='${row.mappingId()}'/></c:url>"><c:out value="${row.transactionCode()}"/></a></c:if></td><td><c:out value="${row.evidence()}"/></td><td><spring:message code="status.${row.state()}"/></td><td><c:out value="${appTime:display(row.linkedAt())}"/></td><td><c:out value="${row.maker()}"/></td><td><a class="app-btn btn-neutral" href="<c:url value='/accounting/journals/${row.id()}'/>"><spring:message code="common.view"/></a></td></tr></c:forEach>
 <c:if test="${empty records.rows()}"><tr><td colspan="7"><spring:message code="common.noRecords"/></td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %>
 </section>
<c:if test="${not empty workspace.paymentEvidenceExpense() and permissions.contains('expense.read') and (permissions.contains('expense.evidence.write') or permissions.contains('expense.evidence.review'))}"><div class="app-actions"><a class="app-btn btn-neutral" href="<c:url value='/finance/expenses/${workspace.paymentEvidenceExpense()}/evidence'/>"><spring:message code="expense.evidence.title"/></a></div></c:if>
<%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
