<%@ page pageEncoding="UTF-8" %>
<div><c:forEach items="${empty templateForm?transactionForm.rules:templateForm.rules}" var="rule" varStatus="n"><section class="voucher-row"><form:hidden path="rules[${n.index}].component"/><c:if test="${rule.component!='TOTAL'}"><h3><spring:message code="voucher.component.${rule.component}"/></h3></c:if><div class="voucher-grid">
<c:forTokens items="debit,credit" delims="," var="side"><div class="fcms-field"><label for="${side}-rule-${n.index}"><spring:message code="gl.mapping.${side}Account"/></label><form:select path="rules[${n.index}].${side}AccountId" id="${side}-rule-${n.index}" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=true"><form:option value=""/><form:options items="${accounts}" itemValue="id" itemLabel="name"/></form:select><form:errors path="rules[${n.index}].${side}AccountId" cssClass="fcms-error"/></div></c:forTokens>
</div></section></c:forEach></div><form:errors path="rules" cssClass="fcms-error"/>
<div class="voucher-grid"><div class="fcms-field"><label for="voucherKind"><spring:message code="gl.kind"/></label><form:select path="voucherKind" id="voucherKind"><c:forTokens items="JOURNAL,RECEIPT,PAYMENT" delims="," var="kind"><form:option value="${kind}"><spring:message code="gl.kind.${kind}"/></form:option></c:forTokens></form:select><form:errors path="voucherKind" cssClass="fcms-error"/></div>
<div class="fcms-field"><label for="cashFlow"><spring:message code="gl.cashFlowClassification"/></label><form:select path="cashFlow" id="cashFlow"><c:forTokens items="NONE,OPERATING,INVESTING,FINANCING,INTERNAL" delims="," var="flow"><form:option value="${flow}"><spring:message code="gl.flow.${flow}"/></form:option></c:forTokens></form:select><form:errors path="cashFlow" cssClass="fcms-error"/></div></div><ui:field path="policyReference" label="gl.policy" type="text"/>
