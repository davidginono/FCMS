<%@ page pageEncoding="UTF-8" %>
<div class="fcms-field"><label for="debitAccountId"><spring:message code="gl.mapping.debitAccount"/></label><form:select path="debitAccountId" id="debitAccountId" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=true"><form:option value=""/><form:options items="${accounts}" itemValue="id" itemLabel="name"/></form:select><form:errors path="debitAccountId" cssClass="fcms-error"/></div>
<div class="fcms-field"><label for="creditAccountId"><spring:message code="gl.mapping.creditAccount"/></label><form:select path="creditAccountId" id="creditAccountId" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=true"><form:option value=""/><form:options items="${accounts}" itemValue="id" itemLabel="name"/></form:select><form:errors path="creditAccountId" cssClass="fcms-error"/></div>
<div class="fcms-field"><label for="voucherKind"><spring:message code="gl.kind"/></label><form:select path="voucherKind" id="voucherKind"><c:forTokens items="JOURNAL,RECEIPT,PAYMENT" delims="," var="kind"><form:option value="${kind}"><spring:message code="gl.kind.${kind}"/></form:option></c:forTokens></form:select><form:errors path="voucherKind" cssClass="fcms-error"/></div>
<div class="fcms-field"><label for="cashFlow"><spring:message code="gl.cashFlowClassification"/></label><form:select path="cashFlow" id="cashFlow"><c:forTokens items="NONE,OPERATING,INVESTING,FINANCING,INTERNAL" delims="," var="flow"><form:option value="${flow}"><spring:message code="gl.flow.${flow}"/></form:option></c:forTokens></form:select><form:errors path="cashFlow" cssClass="fcms-error"/></div>
<ui:field path="policyReference" label="gl.policy" type="text"/>
