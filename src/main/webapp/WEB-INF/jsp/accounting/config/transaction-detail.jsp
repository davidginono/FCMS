<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<link rel="stylesheet" href="<c:url value='/css/accounting-entry.css?v=20261118-split2'/>">
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="config.transaction.details"/></h1>
<div class="app-actions"><c:if test="${permissions.contains('accounting.setup') and transaction.active() and transaction.activityActive()}"><a class="app-btn btn-neutral" href="<c:url value='/accounting/config/transactions/${transaction.id()}/template'/>"><spring:message code="config.template.edit"/></a></c:if></div>
</div>
<section class="erp-resource-section"><h2><spring:message code="common.details"/></h2><div class="fcms-section-body"><dl class="fcms-details">
 <div><dt><spring:message code="config.activity"/></dt><dd><a class="resource-table-id-link" href="<c:url value='/accounting/config/activities/${transaction.activityId()}'/>"><c:out value="${transaction.activityCode()}"/> <c:out value="${transaction.activityName()}"/></a></dd></div><div><dt><spring:message code="config.activity.status"/></dt><dd><spring:message code="status.${transaction.activityActive()?'ACTIVE':'INACTIVE'}"/></dd></div>
 <div><dt><spring:message code="gl.code"/></dt><dd><c:out value="${transaction.code()}"/></dd></div><div><dt><spring:message code="common.name"/></dt><dd><c:out value="${transaction.name()}"/></dd></div><div><dt><spring:message code="config.event"/></dt><dd><spring:message code="gl.event.${transaction.event()}"/></dd></div><div><dt><spring:message code="common.description"/></dt><dd><c:out value="${transaction.description()}"/></dd></div><div><dt><spring:message code="common.status"/></dt><dd><spring:message code="status.${transaction.active()?'ACTIVE':'INACTIVE'}"/></dd></div>
</dl></div></section>

<c:if test="${not empty effective and (empty proposal or proposal.id()!=effective.id())}"><section class="erp-resource-section"><h2><spring:message code="config.template.effective"/></h2><div class="fcms-section-body"><c:set var="template" value="${effective}"/><%@ include file="/WEB-INF/jsp/accounting/config/template-summary.jspf" %></div></section></c:if>
<c:choose><c:when test="${not empty proposal}"><section class="erp-resource-section"><h2><spring:message code="config.template"/></h2><div class="fcms-section-body"><c:set var="template" value="${proposal}"/><%@ include file="/WEB-INF/jsp/accounting/config/template-summary.jspf" %></div></section></c:when><c:otherwise><div class="fcms-alert" role="status"><spring:message code="config.template.missing"/></div></c:otherwise></c:choose>
<c:if test="${not empty actionError}"><div class="fcms-alert" role="alert"><spring:message code="${actionError}"/></div></c:if>
<c:if test="${not empty actionError and (empty proposal or proposal.state()!='PENDING')}"><section class="erp-resource-section"><h2><spring:message code="gl.review"/></h2><div class="fcms-section-body"><div class="fcms-field"><label for="unappliedReason"><spring:message code="gl.mapping.unappliedReason"/></label><textarea id="unappliedReason" readonly rows="3"><c:out value="${param.reason}"/></textarea></div></div></section></c:if>
<c:if test="${not empty proposal and proposal.state()=='PENDING' and ((proposal.makerId()!=actorId and permissions.contains('accounting.review')) or (proposal.makerId()==actorId and permissions.contains('accounting.setup')))}">
<section class="erp-resource-section"><h2><spring:message code="gl.review"/></h2><div class="fcms-section-body">
<c:set var="reviewAction" value="${proposal.makerId()==actorId?'cancel':'approve'}"/><form method="post" action="<c:url value='/accounting/config/transactions/${transaction.id()}/templates/${proposal.id()}/actions/${reviewAction}'/>">
<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="version" value="${proposal.version()}"><input type="hidden" name="transactionVersion" value="${transaction.version()}">
<div class="fcms-field"><label for="reviewReason"><spring:message code="common.reason"/></label><textarea id="reviewReason" name="reason" maxlength="500" required><c:out value="${param.reason}"/></textarea></div>
<div class="fcms-form-actions"><c:choose><c:when test="${proposal.makerId()!=actorId}"><button type="submit" class="app-btn btn-neutral" formaction="<c:url value='/accounting/config/transactions/${transaction.id()}/templates/${proposal.id()}/actions/reject'/>"><spring:message code="common.reject"/></button><button type="submit" class="app-btn btn-launch" ${transaction.active() and transaction.activityActive()?'':'disabled'}><spring:message code="common.approve"/></button></c:when><c:otherwise><button type="submit" class="app-btn btn-neutral" formaction="<c:url value='/accounting/config/transactions/${transaction.id()}/templates/${proposal.id()}/actions/cancel'/>"><spring:message code="common.cancel"/></button></c:otherwise></c:choose></div>
</form></div></section></c:if>
<c:if test="${not empty records.rows() or not empty query.search}"><section class="erp-table-wrap" data-resource-table="${resourceKey}" data-table-page-size="${query.size}" data-table-page-size-options="10 25 50 100"><div class="app-table-titlebar"><h2><spring:message code="config.template.pending"/></h2></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-filters.jspf" %>
<div class="erp-table-scroll"><table class="erp-table"><thead><tr><th scope="col" data-table-sort-key="date" data-table-sort-asc="date" data-table-sort-desc="date"><spring:message code="gl.mapping.createdAt"/></th><th scope="col" data-table-sort-key="maker" data-table-sort-asc="maker" data-table-sort-desc="maker"><spring:message code="gl.maker"/></th><th scope="col" data-table-sort-key="debit" data-table-sort-asc="debit" data-table-sort-desc="debit"><spring:message code="gl.mapping.debitAccount"/></th><th scope="col" data-table-sort-key="credit" data-table-sort-asc="credit" data-table-sort-desc="credit"><spring:message code="gl.mapping.creditAccount"/></th></tr></thead><tbody><c:forEach items="${records.rows()}" var="row"><tr><td><a class="resource-table-id-link" href="<c:url value='/accounting/config/transactions/${transaction.id()}'><c:param name='review' value='${row.id()}'/></c:url>"><c:out value="${appTime:display(row.createdAt())}"/></a></td><td><c:out value="${row.maker()}"/></td><td><c:out value="${row.debitAccount()}"/></td><td><c:out value="${row.creditAccount()}"/></td></tr></c:forEach><c:if test="${empty records.rows()}"><tr><td colspan="4"><spring:message code="common.noRecords"/></td></tr></c:if></tbody></table></div><%@ include file="/WEB-INF/jsp/reusableuicomponents/register-pager.jspf" %></section></c:if>
<c:set var="stateResource" value="${transaction}"/><c:set var="stateUrl" value="/accounting/config/transactions/${transaction.id()}/state"/><%@ include file="/WEB-INF/jsp/accounting/config/state-form.jspf" %>
<%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
