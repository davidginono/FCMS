<%@ page pageEncoding="UTF-8" %>
<dl class="fcms-details">
 <div><dt><spring:message code="gl.kind"/></dt><dd><spring:message code="gl.kind.${template.voucherKind()}"/></dd></div><div><dt><spring:message code="gl.cashFlowClassification"/></dt><dd><spring:message code="gl.flow.${template.cashFlow()}"/></dd></div>
 <div><dt><spring:message code="gl.policy"/></dt><dd><c:out value="${template.policyReference()}"/></dd></div><div><dt><spring:message code="common.status"/></dt><dd><spring:message code="status.${template.state()}"/></dd></div>
 <div><dt><spring:message code="gl.maker"/></dt><dd><c:out value="${template.maker()}"/></dd></div><div><dt><spring:message code="gl.mapping.createdAt"/></dt><dd><c:out value="${appTime:display(template.createdAt())}"/></dd></div>
 <c:if test="${not empty template.checker()}"><div><dt><spring:message code="gl.checker"/></dt><dd><c:out value="${template.checker()}"/></dd></div><div><dt><spring:message code="gl.mapping.reviewedAt"/></dt><dd><c:out value="${appTime:display(template.reviewedAt())}"/></dd></div><div><dt><spring:message code="common.reason"/></dt><dd><c:out value="${template.reviewReason()}"/></dd></div></c:if>
</dl>
<div class="erp-table-scroll"><table class="erp-table" data-table-sort-mode="none" data-table-sort-reason="document"><thead><tr><th><spring:message code="voucher.component"/></th><th><spring:message code="gl.mapping.debitAccount"/></th><th><spring:message code="gl.mapping.creditAccount"/></th></tr></thead><tbody><c:forEach items="${not empty proposal and template.id()==proposal.id()?proposalRules:effectiveRules}" var="rule"><tr><td><spring:message code="voucher.component.${rule.component()}"/></td><td><a class="resource-table-id-link" href="<c:url value='/accounting/accounts/${rule.debitAccountId()}'/>"><c:out value="${rule.debitAccount()}"/></a></td><td><a class="resource-table-id-link" href="<c:url value='/accounting/accounts/${rule.creditAccountId()}'/>"><c:out value="${rule.creditAccount()}"/></a></td></tr></c:forEach></tbody></table></div>