<form method="get" action="<c:url value='${baseUrl}'/>" class="erp-table-toolbar coa-filters">
 <input type="hidden" name="sort" value="<c:out value='${query.sort}'/>">
 <input type="hidden" name="direction" value="<c:out value='${query.direction}'/>">
 <input type="hidden" name="size" value="${query.size}">
 <label class="erp-table-toolbar__search"><spring:message code="common.search"/><input type="search" name="search" maxlength="100" value="<c:out value='${query.search}'/>"></label>
 <label class="erp-table-toolbar__control"><spring:message code="gl.parent"/><select name="parentId" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=false"><option value=""><spring:message code="common.all"/></option><c:forEach items="${filterGlParents}" var="option"><option value="${option.id()}" ${parentId==option.id()?'selected':''}><c:out value="${option.name()}"/></option></c:forEach></select></label>
 <label class="erp-table-toolbar__control"><spring:message code="gl.classification"/><select name="classification"><option value=""><spring:message code="common.all"/></option><c:forEach items="${classifications}" var="classification"><option value="${classification}" ${query.classification==classification?'selected':''}><spring:message code="gl.class.${classification}"/></option></c:forEach></select></label>
 <label class="erp-table-toolbar__control"><spring:message code="gl.coa.column.kind"/><select name="kind"><option value=""><spring:message code="common.all"/></option><option value="GROUP" ${query.kind=='GROUP'?'selected':''}><spring:message code="gl.coa.kind.GROUP"/></option><option value="POSTING" ${query.kind=='POSTING'?'selected':''}><spring:message code="gl.coa.kind.POSTING"/></option></select></label>
 <label class="erp-table-toolbar__control"><spring:message code="common.status"/><select name="status"><option value=""><spring:message code="common.all"/></option><c:forEach items="${registerStatuses}" var="status"><option value="${status}" ${query.status==status?'selected':''}><spring:message code="status.${status}"/></option></c:forEach></select></label>
 <div class="erp-table-toolbar__actions"><button type="submit" class="app-btn btn-neutral"><spring:message code="common.apply"/></button><a class="app-btn btn-neutral" href="<c:url value='${baseUrl}'/>"><spring:message code="common.clear"/></a></div>
</form>
