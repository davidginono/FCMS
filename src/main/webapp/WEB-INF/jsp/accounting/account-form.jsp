<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/WEB-INF/jsp/shared/header.jspf" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<div class="app-page-header"><h1 class="app-page-title"><spring:message code="${editing?'gl.account.edit':form.mode=='POSTING'?'gl.coa.newPosting':'gl.coa.addGroup'}"/></h1></div><c:url var="saveUrl" value="${formAction}"/><form:form modelAttribute="form" method="post" action="${saveUrl}" cssClass="fcms-form" data-resource-create="${not editing}" data-resource-form-page="true"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="version"/><form:hidden path="mode"/><section class="erp-resource-section"><h2><spring:message code="common.details"/></h2><div class="fcms-section-body"><c:choose><c:when test="${editing}"><form:hidden path="parentId"/><form:hidden path="code"/><form:hidden path="normalBalance"/><form:hidden path="cashAccount"/><dl class="fcms-details"><div><dt><spring:message code="gl.code"/></dt><dd><c:out value="${form.code}"/></dd></div></dl></c:when><c:otherwise><div class="fcms-field"><label for="parentId"><spring:message code="gl.parent"/></label><form:select path="parentId" id="parentId" data-choice-url="${pageContext.request.contextPath}/accounting/accounts/choices?posting=false&amp;parentMode=${form.mode}" data-code-url="${pageContext.request.contextPath}/accounting/accounts/next-code"><form:option value=""/><c:forEach items="${parents}" var="parent"><form:option value="${parent.id()}" data-depth="${parent.depth()}" data-classification="${parent.classification()}" data-normal-balance="${parent.normalBalance()}"><c:out value="${parent.name()}"/></form:option></c:forEach></form:select><form:errors path="parentId" cssClass="fcms-error"/></div><ui:field path="code" label="gl.code" type="text"/><span class="fcms-error" role="status" data-code-status data-unavailable="<spring:message code='gl.coa.codeUnavailable'/>" data-error="<spring:message code='gl.coa.suggestionError'/>"><c:if test="${codeRangeExhausted}"><spring:message code="gl.coa.codeUnavailable"/></c:if></span></c:otherwise></c:choose><ui:field path="name" label="common.name" type="text"/><div class="fcms-field"><label for="description"><spring:message code="common.description"/></label><form:textarea path="description" id="description" maxlength="500"/><form:errors path="description" cssClass="fcms-error"/></div><c:if test="${not editing}"><div class="fcms-field"><label for="normalBalance"><spring:message code="gl.normal"/></label><form:select path="normalBalance" id="normalBalance"><form:option value="DEBIT"><spring:message code="gl.debit"/></form:option><form:option value="CREDIT"><spring:message code="gl.credit"/></form:option></form:select><form:errors path="normalBalance" cssClass="fcms-error"/></div><div class="fcms-field"><label class="fcms-check-label"><form:checkbox path="cashAccount"/><spring:message code="gl.cashAccount"/></label><form:errors path="cashAccount" cssClass="fcms-error"/></div></c:if></div></section><form:errors path="" element="div" cssClass="fcms-alert" role="alert"/><form:errors path="version" element="div" cssClass="fcms-alert" role="alert"/><div class="fcms-form-actions"><c:url var="cancelUrl" value="/accounting/accounts"><c:if test="${form.parentId ne null}"><c:param name="parentId" value="${form.parentId}"/></c:if></c:url><a class="app-btn btn-neutral" href="${cancelUrl}"><spring:message code="common.cancel"/></a><button class="app-btn btn-launch" type="submit"><spring:message code="${not editing ? 'common.create' : 'common.save'}"/></button></div></form:form><script defer src="<c:url value='/js/account-form.js?v=20261116-coa-tree2'/>"></script><%@ include file="/WEB-INF/jsp/shared/footer.jspf" %>
