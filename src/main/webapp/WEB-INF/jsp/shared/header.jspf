<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FCMS</title>
    <link rel="stylesheet" href="<c:url value='/css/app.css' />">
    <script defer src="<c:url value='/js/app.js' />"></script>
</head>
<body class="fcms-shell">
<div class="min-h-screen lg:flex">
    <aside data-fcms-sidebar class="hidden w-64 shrink-0 border-r border-fcms-line bg-white lg:block">
        <div class="flex h-16 items-center gap-3 border-b border-fcms-line px-5">
            <img src="<c:url value='/img/app-logo.png' />" alt="FCMS" class="h-9 w-9 rounded object-cover">
            <div>
                <div class="text-sm font-bold text-fcms-ink">FCMS</div>
                <div class="text-xs text-fcms-muted">Client management</div>
            </div>
        </div>
        <nav class="space-y-1 px-3 py-4">
            <a class="fcms-sidebar-link" href="<c:url value='/dashboard' />">Dashboard</a>
            <a class="fcms-sidebar-link" href="<c:url value='/clients/saccos' />">SACCOS</a>
            <a class="fcms-sidebar-link" href="<c:url value='/tasks' />">Tasks</a>
            <a class="fcms-sidebar-link" href="<c:url value='/finance/expenses' />">Expenses</a>
            <a class="fcms-sidebar-link" href="<c:url value='/reports' />">Reports</a>
        </nav>
    </aside>

    <div class="min-w-0 flex-1">
        <header class="sticky top-0 z-10 border-b border-fcms-line bg-white/95 backdrop-blur">
            <div class="flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
                <button data-fcms-menu type="button" class="rounded-md border border-fcms-line px-3 py-2 text-sm font-semibold text-slate-700 lg:hidden">
                    Menu
                </button>
                <div class="hidden text-sm text-fcms-muted lg:block">Spring Boot migration workspace</div>
                <div class="flex items-center gap-4">
                    <span class="text-sm font-medium text-slate-700">${pageContext.request.userPrincipal.name}</span>
                    <form method="post" action="<c:url value='/logout' />">
                        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                        <button type="submit" class="rounded-md border border-fcms-line px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                            Logout
                        </button>
                    </form>
                </div>
            </div>
        </header>
        <main class="px-4 py-6 sm:px-6 lg:px-8">
